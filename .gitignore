# dependencies
node_modules/
.pnpm-store/

# build output
dist/
.astro/
*.tsbuildinfo

# wrangler's local state (`wrangler pages dev`, used to serve dist as Pages does)
.wrangler/

# apps/web — generated at build time, never commit
apps/web/public/_redirects
apps/web/public/ads.txt
apps/web/functions/_data/
apps/web/.d1-cache/
apps/web/.cms-cache/
apps/web/src/content/blog/

# npm lockfile — pnpm is the workspace package manager
package-lock.json

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production
.env.local

# local credential scratchpads — NEVER commit
keys.md
secrets.md

# postgres data volume (docker compose bind mount fallback)
.pgdata/

# up.sh / down.sh runtime state (logs + pids)
.run/

# DevTeam verification runs (browser screenshots, logs)
.devteam-run/

# macOS
.DS_Store

# editors
.idea/
