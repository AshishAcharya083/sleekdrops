---
import type { Promo } from '@data/promos';

/**
 * PromoCard — variation of DealCard with the prominent code chip instead
 * of strike-through pricing.
 */
export interface Props { promo: Promo; }
const { promo } = Astro.props;
---
<a class="promo-card" href={`/promos/${promo.slug}`}>
  <div class="head">
    <div class="logo" aria-hidden="true">{promo.brandMark}</div>
    <div>
      <span class="brand-name">{promo.brand}</span>
      <span class="disc">{promo.discountLabel}</span>
    </div>
  </div>
  <p class="title">{promo.title}</p>
  <div class="code-row">
    <span class="code-label">CODE</span>
    <code>{promo.code}</code>
  </div>
  <span class="ends">{promo.ends}</span>
</a>

<style>
  .promo-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 16px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-decoration: none;
    color: inherit;
    transition: all var(--dur-base) var(--ease-out);
  }
  .promo-card:hover {
    border-color: var(--hairline-strong);
    box-shadow: var(--shadow-md);
    color: inherit;
  }
  .head {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .logo {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 20px;
    flex-shrink: 0;
  }
  .brand-name {
    display: block;
    font-size: 11px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 700;
  }
  .disc {
    display: block;
    font-size: 13px;
    color: var(--ink);
    font-weight: 700;
  }
  .title {
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.2;
    color: var(--ink);
    letter-spacing: -0.01em;
    margin: 0;
  }
  .code-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
    padding: 10px 14px;
    background: var(--surface-2);
    border-radius: var(--r-md);
  }
  .code-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--muted);
  }
  code {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    background: transparent;
    padding: 0;
    color: var(--ink);
  }
  .ends {
    font-size: 11px;
    color: var(--muted);
  }
</style>
