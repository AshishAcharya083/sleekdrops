---
import { Image } from 'astro:assets';
import BuyButton from './BuyButton.astro';
import StarRating from './StarRating.astro';
import type { Product } from '../../types';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const image = product.imageUrl ?? '/og-default.png';
---

<article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-card">
  <Image src={image} alt={product.name} width={800} height={800} class="h-56 w-full rounded-[1.5rem] object-cover" />
  <h3 class="mt-4 font-display text-2xl font-bold text-ink">{product.name}</h3>
  <p class="mt-2 text-sm leading-7 text-slate-600">{product.description}</p>
  {product.rating && <div class="mt-4"><StarRating rating={product.rating} /></div>}
  <div class="mt-4 flex flex-wrap gap-4 text-sm font-medium text-slate-700">
    {product.originalPrice && <span>Was ${product.originalPrice}</span>}
    {product.salePrice && <span>Now ${product.salePrice}</span>}
  </div>
  <div class="mt-5">
    <BuyButton href={product.affiliateUrl} />
  </div>
</article>
