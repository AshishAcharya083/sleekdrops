---
interface OddsRow {
  market: string;
  operator: string;
  odds: string;
  promo?: string;
}

interface Props {
  rows: OddsRow[];
}

const { rows } = Astro.props;
---

<div class="overflow-x-auto rounded-3xl border border-slate-200 bg-white shadow-card">
  <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
    <thead class="bg-slate-50 text-slate-500">
      <tr>
        <th class="px-4 py-3 font-semibold">Market</th>
        <th class="px-4 py-3 font-semibold">Operator</th>
        <th class="px-4 py-3 font-semibold">Odds</th>
        <th class="px-4 py-3 font-semibold">Promo</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      {rows.map((row) => (
        <tr>
          <td class="px-4 py-3 font-medium text-ink">{row.market}</td>
          <td class="px-4 py-3 text-slate-600">{row.operator}</td>
          <td class="px-4 py-3 text-slate-600">{row.odds}</td>
          <td class="px-4 py-3 text-slate-600">{row.promo ?? '-'}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
