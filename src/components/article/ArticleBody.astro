---
/**
 * ArticleBody — the editorial body wrapper. Wrap the rendered markdown
 * <Content /> with this; it owns the prose typography, drop-cap, and
 * inline-link treatments.
 */
---
<div class="article-body">
  <slot />
</div>

<style>
  .article-body {
    max-width: 68ch;
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.75;
    color: var(--ink-2);
    min-width: 0;
  }
  .article-body :global(> * + *) { margin-top: 1.3em; }
  .article-body :global(p) { margin: 0; }
  .article-body :global(> p:first-of-type::first-letter) {
    font-family: var(--font-display);
    font-size: 88px;
    line-height: 0.85;
    float: left;
    margin: 8px 12px 0 0;
    color: var(--ink);
    font-weight: 400;
  }
  .article-body :global(h2) {
    font-family: var(--font-display);
    font-size: 40px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 400;
    color: var(--ink);
    margin: 2.2em 0 0.4em;
    scroll-margin-top: 100px;
  }
  .article-body :global(h2 em) { font-style: italic; }
  .article-body :global(h3) {
    font-family: var(--font-body);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 1.8em 0 0.4em;
    scroll-margin-top: 100px;
  }
  .article-body :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
  }
  .article-body :global(a:hover) { color: var(--accent); }
  .article-body :global(em) {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05em;
  }
  .article-body :global(strong) { color: var(--ink); font-weight: 700; }
  .article-body :global(ul),
  .article-body :global(ol) { padding-left: 1.25em; }
  .article-body :global(li) { margin: 0.5em 0; }
  .article-body :global(img) {
    width: 100%;
    border-radius: 16px;
    margin: 1.5em 0;
  }
  .article-body :global(blockquote) {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 30px;
    line-height: 1.3;
    color: var(--ink);
    border-left: 2px solid var(--accent);
    padding: 4px 0 4px 28px;
    margin: 2em 0;
    max-width: 38ch;
    letter-spacing: -0.005em;
  }
</style>
