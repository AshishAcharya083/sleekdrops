---
import type { Author } from '../../types';

interface Props {
  author: Author;
}

const { author } = Astro.props;
---

<aside class="rounded-3xl border border-slate-200 bg-white p-6 shadow-card" itemtype="https://schema.org/Person" itemscope>
  <p class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">Written by</p>
  <h3 class="mt-2 text-xl font-bold text-ink" itemprop="name">{author.name}</h3>
  <p class="mt-1 text-sm font-medium text-summit" itemprop="jobTitle">{author.role}</p>
  {author.bio && <p class="mt-4 text-sm leading-7 text-slate-600" itemprop="description">{author.bio}</p>}
  {author.twitterUrl && (
    <a class="mt-4 inline-flex text-sm font-semibold text-summit hover:text-ember" href={author.twitterUrl}>
      Follow on X
    </a>
  )}
</aside>
