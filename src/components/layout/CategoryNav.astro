---
const categories = ['tech', 'home', 'fashion', 'health', 'finance', 'travel'];
---

<div class="overflow-x-auto pb-2">
  <div class="flex min-w-max gap-3">
    {categories.map((category) => (
      <a
        class="rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:border-summit hover:text-summit"
        href={`/category/${category}`}
      >
        {category}
      </a>
    ))}
  </div>
</div>
