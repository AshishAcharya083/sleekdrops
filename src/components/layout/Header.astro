---
import Nav from './Nav.astro';
---

<header class="sticky top-0 z-20 border-b border-slate-200/70 bg-white/85 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-4 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-3">
      <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-summit font-display text-lg font-bold text-white">SO</span>
      <span>
        <span class="block font-display text-xl font-bold text-ink">SleekDrops</span>
        <span class="block text-xs uppercase tracking-[0.3em] text-slate-500">Reviews deals promos</span>
      </span>
    </a>
    <Nav />
  </div>
</header>
