---
import { Image } from 'astro:assets';
import Badge from '../ui/Badge.astro';
import type { Post } from '../../types';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const imageSrc = post.featuredImage ?? '/og-default.png';
---

<article class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-card">
  <a href={`/blog/${post.slug}`} class="block">
    <Image src={imageSrc} alt={post.title} width={1200} height={630} class="h-56 w-full object-cover" />
  </a>
  <div class="p-6">
    <Badge label={post.category} />
    <h2 class="mt-4 font-display text-2xl font-bold tracking-tight text-ink">
      <a href={`/blog/${post.slug}`} class="hover:text-summit">{post.title}</a>
    </h2>
    <p class="mt-3 text-sm leading-7 text-slate-600">{post.description}</p>
    <div class="mt-5 flex items-center justify-between text-xs font-medium uppercase tracking-[0.2em] text-slate-500">
      <span>{post.author}</span>
      <span>{post.readingTime} min read</span>
    </div>
  </div>
</article>
