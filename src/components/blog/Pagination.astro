---
interface Props {
  currentPage: number;
  totalPages: number;
  basePath: string;
}

const { currentPage, totalPages, basePath } = Astro.props;

function pageHref(page: number): string {
  return page === 1 ? basePath : `${basePath}/${page}`;
}
---

{totalPages > 1 && (
  <nav class="mt-10 flex items-center justify-between rounded-3xl border border-slate-200 bg-white p-5 shadow-card" aria-label="Pagination">
    <a
      class:list={[
        'text-sm font-semibold',
        currentPage === 1 ? 'pointer-events-none text-slate-300' : 'text-summit hover:text-ember',
      ]}
      href={pageHref(currentPage - 1)}
    >
      Previous
    </a>
    <p class="text-sm text-slate-600">Page {currentPage} of {totalPages}</p>
    <a
      class:list={[
        'text-sm font-semibold',
        currentPage === totalPages ? 'pointer-events-none text-slate-300' : 'text-summit hover:text-ember',
      ]}
      href={pageHref(currentPage + 1)}
    >
      Next
    </a>
  </nav>
)}
