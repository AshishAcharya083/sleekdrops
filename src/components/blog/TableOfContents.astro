---
interface Heading {
  id: string;
  text: string;
  level: 2 | 3;
}

interface Props {
  content: string;
}

const { content } = Astro.props;
const headings: Heading[] = content
  .split('\n')
  .filter((line) => line.startsWith('## '))
  .map((line) => ({
    id: line
      .replace(/^##+\s+/, '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/(^-|-$)/g, ''),
    text: line.replace(/^##+\s+/, ''),
    level: line.startsWith('### ') ? 3 : 2,
  }));
---

{headings.length > 0 && (
  <aside class="rounded-3xl border border-slate-200 bg-white p-6 shadow-card">
    <h2 class="font-display text-lg font-bold text-ink">On this page</h2>
    <ul class="mt-4 space-y-3 text-sm text-slate-600">
      {headings.map((heading) => (
        <li class={heading.level === 3 ? 'pl-4' : ''}>
          <a href={`#${heading.id}`} class="hover:text-summit">{heading.text}</a>
        </li>
      ))}
    </ul>
  </aside>
)}
