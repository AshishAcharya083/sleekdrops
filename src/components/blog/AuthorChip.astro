---
import { getAuthor, authorInitials } from '@data/authors';
import { formatLong } from '@lib/format';

/**
 * AuthorChip — small byline block. Used in the article header next to the
 * date and read-time stats.
 */
export interface Props {
  authorId: string;
  date: Date;
  readTime: number;
}
const { authorId, date, readTime } = Astro.props;
const author = getAuthor(authorId);
---
<div class="author-chip">
  <a class="avatar" href={`/author/${author.id}`} aria-hidden="true">{authorInitials(author)}</a>
  <div class="meta">
    <div class="name"><a href={`/author/${author.id}`}>{author.name}</a></div>
    <div class="sub">{formatLong(date)} · {readTime} min read</div>
  </div>
</div>

<style>
  .author-chip {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .avatar {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 16px;
    letter-spacing: 0.02em;
    text-decoration: none;
  }
  .avatar:hover { color: var(--paper); }
  .name {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
  }
  .name a { color: inherit; text-decoration: none; }
  .name a:hover { color: var(--accent); }
  .sub {
    font-size: 12px;
    color: var(--muted);
  }
</style>
