---
import { Image } from 'astro:assets';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import AffiliateDisclosure from '../components/affiliate/AffiliateDisclosure.astro';
import PostHeader from '../components/blog/PostHeader.astro';
import PostBody from '../components/blog/PostBody.astro';
import RelatedPosts from '../components/blog/RelatedPosts.astro';
import TableOfContents from '../components/blog/TableOfContents.astro';
import type { Author, Post } from '../types';
import AuthorCard from '../components/ui/AuthorCard.astro';

interface Props {
  post: Post;
  author?: Author;
  relatedPosts: Post[];
}

const { post, author, relatedPosts } = Astro.props;
const imageSrc = post.featuredImage ?? '/og-default.png';
---

<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
  <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Blog', href: '/blog' }, { name: post.title, href: `/blog/${post.slug}` }]} />
  <div class="content-grid mt-6">
    <article class="min-w-0">
      <AffiliateDisclosure />
      <div class="mt-6">
        <PostHeader post={post} />
      </div>
      <Image src={imageSrc} alt={post.title} width={1200} height={630} class="mt-8 rounded-[2rem] object-cover" />
      <div class="mt-8">
        <PostBody content={post.content} />
      </div>
      <RelatedPosts posts={relatedPosts} />
    </article>
    <aside class="space-y-6">
      <TableOfContents content={post.content} />
      {author && <AuthorCard author={author} />}
    </aside>
  </div>
</section>
