---
import SEOHead from '@components/seo/SEOHead.astro';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import ConsentBanner from '@components/layout/ConsentBanner.astro';
import '@styles/tokens.css';
import '@styles/global.css';
import type { Thing, WithContext } from 'schema-dts';
import type { MetaPayload } from '@lib/seo';
import type { ComponentProps } from 'astro/types';

/**
 * BaseLayout — wraps every page with head, sticky header, footer, and
 * (optionally) the reading-progress bar / theme-toggle island.
 *
 * Pass the MetaPayload from buildMeta() and an optional `active` nav id.
 * `progress` defaults to true on article pages — keep it off for
 * listings, where the bar implies more content than there is.
 */
type HeaderActive = ComponentProps<typeof Header>['active'];

export interface Props extends MetaPayload {
  schema?: WithContext<Thing>;
  active?: HeaderActive;
  /** Show the 2px reading progress bar. */
  progress?: boolean;
  /**
   * Canonical screen name. When set, chrome.ts fires the `Page Viewed`
   * event for this page (see docs/analytics-events.md).
   */
  screen?: string;
  /**
   * Extra page-view properties (category, deal slug/brand, …). Keep these
   * non-PII; values that are undefined are dropped.
   */
  pageProps?: Record<string, string | undefined>;
}

const { schema, active, progress = false, screen, pageProps, ...meta } = Astro.props;

const pageView = screen
  ? {
      screen,
      ...Object.fromEntries(
        Object.entries(pageProps ?? {}).filter(([, v]) => v != null),
      ),
    }
  : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <SEOHead {...meta} schema={schema} />
  </head>
  <body class="page" data-page-view={pageView ? JSON.stringify(pageView) : undefined}>
    {progress && <div class="progress-bar" aria-hidden="true" />}
    <Header active={active} />
    <main>
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
    <script>
      import '../scripts/chrome';
    </script>
    <script>
      import '../scripts/devteam-analytics';
    </script>
  </body>
</html>
