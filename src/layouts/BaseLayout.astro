---
import SEOHead from '@components/seo/SEOHead.astro';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import '@styles/tokens.css';
import '@styles/global.css';
import type { Thing, WithContext } from 'schema-dts';
import type { MetaPayload } from '@lib/seo';
import type { ComponentProps } from 'astro/types';

/**
 * BaseLayout — wraps every page with head, sticky header, footer, and
 * (optionally) the reading-progress bar / theme-toggle island.
 *
 * Pass the MetaPayload from buildMeta() and an optional `active` nav id.
 * `progress` defaults to true on article pages — keep it off for
 * listings, where the bar implies more content than there is.
 */
type HeaderActive = ComponentProps<typeof Header>['active'];

export interface Props extends MetaPayload {
  schema?: WithContext<Thing>;
  active?: HeaderActive;
  /** Show the 2px reading progress bar. */
  progress?: boolean;
}

const { schema, active, progress = false, ...meta } = Astro.props;

// GA4 Measurement ID — set PUBLIC_GA4_ID in .env (local) and as a GitHub
// Actions secret (CI). Omitting it disables analytics silently.
const ga4Id = import.meta.env.PUBLIC_GA4_ID;
---
<!doctype html>
<html lang="en">
  <head>
    <SEOHead {...meta} schema={schema} />
    {ga4Id && (
      <Fragment>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
        <script is:inline define:vars={{ ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){ dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', ga4Id);
        </script>
      </Fragment>
    )}
  </head>
  <body class="page">
    {progress && <div class="progress-bar" aria-hidden="true" />}
    <Header active={active} />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/chrome';
    </script>
  </body>
</html>
