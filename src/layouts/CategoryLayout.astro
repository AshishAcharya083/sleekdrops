---
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import PostGrid from '../components/blog/PostGrid.astro';
import Pagination from '../components/blog/Pagination.astro';
import type { Post } from '../types';

interface Props {
  title: string;
  description: string;
  posts: Post[];
  currentPage: number;
  totalPages: number;
  basePath: string;
}

const { title, description, posts, currentPage, totalPages, basePath } = Astro.props;
---

<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
  <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: title, href: basePath }]} />
  <div class="mt-6 rounded-[2rem] border border-slate-200 bg-white p-8 shadow-card">
    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-summit">Archive</p>
    <h1 class="mt-3 font-display text-4xl font-bold text-ink">{title}</h1>
    <p class="mt-4 max-w-reading text-lg leading-8 text-slate-600">{description}</p>
  </div>
  <div class="mt-8">
    <PostGrid posts={posts} />
    <Pagination currentPage={currentPage} totalPages={totalPages} basePath={basePath} />
  </div>
</section>
