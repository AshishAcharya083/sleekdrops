---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import PromoCard from '../../components/affiliate/PromoCard.astro';
import { buildCategorySchema, buildMeta } from '../../lib/seo';
import { getPromos } from '../../lib/api';

const promos = await getPromos();
const meta = buildMeta({
  title: 'Live promo codes',
  description:
    'SleekDrops keeps promo pages server-rendered so brand offers, expiry dates, and code availability stay fresh for both users and crawlers.',
  pathname: '/promos',
});
---

<BaseLayout {...meta} schema={buildCategorySchema('Promos', '/promos', meta.description)}>
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Promos', href: '/promos' }]} />
    <div class="mt-6 rounded-[2rem] border border-slate-200 bg-white p-8 shadow-card">
      <h1 class="font-display text-4xl font-bold text-ink">Live promo inventory</h1>
      <p class="mt-4 max-w-reading text-lg leading-8 text-slate-600">This route stays SSR to preserve freshness for promo codes, operator status, and expiry windows.</p>
    </div>
    <div class="mt-8 grid gap-6">
      {promos.map((promo) => <PromoCard promo={promo} />)}
    </div>
  </section>
</BaseLayout>
