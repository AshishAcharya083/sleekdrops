---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import ListingHero from '@components/blog/ListingHero.astro';
import PostGrid from '@components/blog/PostGrid.astro';
import Pagination from '@components/blog/Pagination.astro';
import { getAllPosts, type BlogPost } from '@lib/posts';
import { buildCategorySchema, buildMeta } from '@lib/seo';

/**
 * Paginated blog index. `[...page]` matches `/blog` (page 1) and
 * `/blog/2`, `/blog/3`, … etc.
 */
export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getAllPosts();
  return paginate(posts, { pageSize: 9 });
}) satisfies GetStaticPaths;

interface Props { page: Page<BlogPost>; }
const { page } = Astro.props;

const baseDescription =
  'Reviews, buying guides, and side-by-side comparisons. Every post is independent — we make our money from affiliate links, never from sponsorships or paid placements.';

const meta = buildMeta({
  title: page.currentPage === 1 ? 'The blog' : `The blog — page ${page.currentPage}`,
  description: baseDescription,
  pathname: page.url.current,
  prevUrl: page.url.prev ?? undefined,
  nextUrl: page.url.next ?? undefined,
});
---
<BaseLayout
  {...meta}
  schema={buildCategorySchema('SleekDrops Blog', '/blog', baseDescription)}
  active="blog"
>
  <ListingHero
    eyebrow="Editorial · Refreshed daily"
    titleHtml="The <em>blog</em>."
    dek={baseDescription}
  />
  <div class="container">
    <div class="listing-grid">
      <PostGrid posts={page.data} columns={3} />
    </div>
    <Pagination
      currentPage={page.currentPage}
      lastPage={page.lastPage}
      basePath="/blog"
    />
  </div>
</BaseLayout>

<style>
  .listing-grid { padding: 48px 0 16px; }
</style>
