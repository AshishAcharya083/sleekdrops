---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryLayout from '../../layouts/CategoryLayout.astro';
import { buildCategorySchema, buildMeta } from '../../lib/seo';
import { getPosts } from '../../lib/api';

const posts = await getPosts({ page: 1, limit: 12, postType: 'article' });
const meta = buildMeta({
  title: 'All blog articles',
  description: 'Browse SleekDrops articles, guides, and affiliate-safe editorial content across tech, home, fashion, health, travel, and finance.',
  pathname: '/blog',
  nextUrl: posts.totalPages > 1 ? `${import.meta.env.SITE_URL ?? 'https://sleekdrops.com'}/blog/2` : undefined,
});
---

<BaseLayout {...meta} schema={buildCategorySchema('SleekDrops Blog', '/blog', meta.description)}>
  <CategoryLayout
    title="SleekDrops Blog"
    description="Evergreen affiliate editorial and educational content built for indexation and scale."
    posts={posts.data}
    currentPage={1}
    totalPages={posts.totalPages}
    basePath="/blog"
  />
</BaseLayout>
