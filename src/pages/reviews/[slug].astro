---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductReviewLayout from '../../layouts/ProductReviewLayout.astro';
import { buildMeta, buildReviewSchema } from '../../lib/seo';
import { getAllAuthors, getProductBySlug, getReviewBySlug, getReviews } from '../../lib/api';

export async function getStaticPaths() {
  const reviews = await getReviews({ page: 1 });
  return reviews.data.map((post) => ({ params: { slug: post.slug } }));
}

const slug = Astro.params.slug ?? '';
const review = await getReviewBySlug(slug);
if (!review) return Astro.redirect('/reviews');

const [product, authors] = await Promise.all([getProductBySlug(slug), getAllAuthors()]);
const author = authors.find((entry) => entry.slug === review.author || entry.name === review.author);
const meta = buildMeta({
  title: review.seoTitle ?? review.title,
  description: review.seoDescription ?? review.description,
  pathname: `/reviews/${review.slug}`,
  image: product?.imageUrl ?? review.featuredImage,
  type: 'article',
  noindex: review.noindex,
});
---

<BaseLayout {...meta} schema={buildReviewSchema(review, product)}>
  <ProductReviewLayout post={review} product={product} author={author} />
</BaseLayout>
