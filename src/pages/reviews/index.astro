---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryLayout from '../../layouts/CategoryLayout.astro';
import { buildCategorySchema, buildMeta } from '../../lib/seo';
import { getReviews } from '../../lib/api';

const reviews = await getReviews({ page: 1 });
const meta = buildMeta({
  title: 'All product reviews',
  description: 'SleekDrops review archives highlight in-depth product coverage with updated timestamps, structured data, and clear affiliate disclosures.',
  pathname: '/reviews',
  nextUrl: reviews.totalPages > 1 ? `${import.meta.env.SITE_URL ?? 'https://sleekdrops.com'}/reviews/2` : undefined,
});
---

<BaseLayout {...meta} schema={buildCategorySchema('SleekDrops Reviews', '/reviews', meta.description)}>
  <CategoryLayout
    title="SleekDrops Reviews"
    description="Detailed review coverage with balanced pros and cons, pricing context, and schema-ready product pages."
    posts={reviews.data}
    currentPage={1}
    totalPages={reviews.totalPages}
    basePath="/reviews"
  />
</BaseLayout>
