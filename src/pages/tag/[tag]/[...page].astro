---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/seo/Breadcrumbs.astro';
import ListingHero from '@components/blog/ListingHero.astro';
import PostGrid from '@components/blog/PostGrid.astro';
import Pagination from '@components/blog/Pagination.astro';
import { getAllPosts, getPostsByTag, type BlogPost } from '@lib/posts';
import { buildCategorySchema, buildMeta } from '@lib/seo';
import { slugify } from '@lib/format';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getAllPosts();
  const tags = new Set<string>();
  for (const post of posts) {
    for (const t of post.data.tags) tags.add(t);
  }

  const out = [];
  for (const tag of tags) {
    const tagged = await getPostsByTag(tag);
    const paginated = paginate(tagged, {
      params: { tag: slugify(tag) },
      pageSize: 9,
      props: { tag },
    });
    out.push(...paginated);
  }
  return out;
}) satisfies GetStaticPaths;

interface Props { page: Page<BlogPost>; tag: string; }
const { page, tag } = Astro.props;
const slug = slugify(tag);
const desc = `Every post tagged with “${tag}.”`;

const meta = buildMeta({
  title:
    page.currentPage === 1
      ? `#${tag}`
      : `#${tag} — page ${page.currentPage}`,
  description: desc,
  pathname: page.url.current,
  prevUrl: page.url.prev ?? undefined,
  nextUrl: page.url.next ?? undefined,
});
---
<BaseLayout
  {...meta}
  schema={buildCategorySchema(`#${tag}`, `/tag/${slug}`, desc)}
  active="blog"
>
  <div class="container">
    <Breadcrumbs
      items={[
        { name: 'Home', href: '/' },
        { name: 'Blog', href: '/blog' },
        { name: `#${tag}`, href: `/tag/${slug}` },
      ]}
    />
  </div>

  <ListingHero
    eyebrow="Tag"
    titleHtml={`Tagged <em>${tag}</em>.`}
    dek={desc}
  />

  <div class="container">
    <div class="listing-grid">
      <PostGrid posts={page.data} columns={3} />
    </div>
    <Pagination
      currentPage={page.currentPage}
      lastPage={page.lastPage}
      basePath={`/tag/${slug}`}
    />
  </div>
</BaseLayout>

<style>
  .listing-grid { padding: 48px 0 16px; }
</style>
