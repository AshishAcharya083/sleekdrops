---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/seo/Breadcrumbs.astro';
import ListingHero from '@components/blog/ListingHero.astro';
import DropPanel from '@components/affiliate/DropPanel.astro';
import DealCard from '@components/affiliate/DealCard.astro';
import AffiliateDisclosure from '@components/affiliate/AffiliateDisclosure.astro';
import { getActiveDeals, todaysDrop } from '@data/deals';
import { buildCategorySchema, buildMeta } from '@lib/seo';

const deals = getActiveDeals().filter((d) => d.id !== todaysDrop?.id);

const desc =
  "Live affiliate deals worth your attention — curated daily, dropped when the price actually drops. We list every code in plain text and every expiry up front.";

const meta = buildMeta({
  title: "Today's drops & deals",
  description: desc,
  pathname: '/deals',
});
---
<BaseLayout
  {...meta}
  schema={buildCategorySchema('Daily deals', '/deals', desc)}
  active="deals"
>
  <div class="container">
    <Breadcrumbs
      items={[
        { name: 'Home', href: '/' },
        { name: 'Deals', href: '/deals' },
      ]}
    />
  </div>

  <ListingHero
    eyebrow="Live now"
    titleHtml="Today's <em>drops</em>."
    dek={desc}
  />

  <div class="container">
    <div class="deals-hero">
      <DropPanel />
    </div>

    <h2 class="rest-title">More this week</h2>
    <div class="deals-grid">
      {deals.map((deal) => <DealCard deal={deal} />)}
    </div>

    <div class="disclosure-wrap">
      <AffiliateDisclosure />
    </div>
  </div>
</BaseLayout>

<style>
  .deals-hero { padding: 48px 0 32px; }
  .rest-title {
    font-family: var(--font-display);
    font-size: 36px;
    letter-spacing: -0.02em;
    margin: 56px 0 24px;
    font-weight: 400;
    color: var(--ink);
  }
  .deals-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  @media (max-width: 900px) { .deals-grid { grid-template-columns: 1fr; } }
  .disclosure-wrap { padding: 80px 0 32px; max-width: 68ch; }
</style>
