# PeakOdds' own Supabase project, the one the agent publishes PeakOdds posts
# to. scripts/fetch-content.mjs reads published posts from it before every dev
# server start and build, and fails when either value is missing. Both are
# public: the publishable key can read published posts and nothing else.
# Supabase -> Project Settings -> API (Project URL, Publishable key).
PEAKODDS_SUPABASE_URL=
PEAKODDS_SUPABASE_PUBLISHABLE_KEY=

# The origin every canonical URL is built from. Pages fail to build without it.
# Locally, the dev server's own address.
PEAKODDS_SITE_URL=http://localhost:4321
