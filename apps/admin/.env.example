# Agent API base baked into the build. Empty = same origin (the agent server
# serves this SPA). The panel's header field overrides it at runtime.
VITE_API_BASE=

# DevTeam Analytics - public ingest key (dtp_...) for this project. Must be the
# same DevTeam project the website reports to, so admin and site journeys land
# in one Analytics tab. Safe to expose (ingest-only). Leave empty to disable the
# sink silently - the panel keeps working, it just reports nothing.
VITE_DEVTEAM_ANALYTICS_INGEST_KEY=

# DevTeam Analytics ingest host, e.g. https://ingest.getdevteam.ai.
# Leave empty to disable the sink silently.
VITE_DEVTEAM_ANALYTICS_HOST=
