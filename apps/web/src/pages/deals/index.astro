---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/seo/Breadcrumbs.astro';
import ListingHero from '@components/blog/ListingHero.astro';
import DropPanel from '@components/affiliate/DropPanel.astro';
import DealCard from '@components/affiliate/DealCard.astro';
import AffiliateDisclosure from '@components/affiliate/AffiliateDisclosure.astro';
import { getActiveDeals, todaysDrop } from '@data/deals';
import { buildCategorySchema, buildMeta } from '@lib/seo';
import { listViewProps } from '@lib/listing';

const deals = getActiveDeals().filter((d) => d.id !== todaysDrop?.id);

const desc =
  "Live affiliate deals worth your attention — curated daily, dropped when the price actually drops. We list every code in plain text and every expiry up front.";

const meta = buildMeta({
  title: "Today's drops & deals",
  description: desc,
  pathname: '/deals',
  // Nothing to list yet: a thin page, kept out of the index until there is.
  noindex: deals.length === 0 && !todaysDrop,
});
---
<BaseLayout
  {...meta}
  schema={buildCategorySchema('Daily deals', '/deals', desc)}
  active="deals"
  screen="deals-listing"
>
  <div class="container">
    <Breadcrumbs
      items={[
        { name: 'Home', href: '/' },
        { name: 'Deals', href: '/deals' },
      ]}
    />
  </div>

  <ListingHero
    eyebrow="Live now"
    titleHtml="Today's <em>drops</em>."
    dek={desc}
  />

  <div class="container">
    <div class="deals-hero">
      {/* No action on this page: "browse past drops" would point /deals at
          itself, and the empty state directly below already carries the one
          real next step. Two buttons to the same place inside one screen is
          noise, not a second option. */}
      <DropPanel />
    </div>

    {/* The list-view hook sits on the region rather than on the grid, so the
        event is emitted whichever branch renders: a listing that showed a
        visitor nothing is a `count: 0` row, not a missing one. */}
    <section data-list-view={JSON.stringify(listViewProps({ listId: 'deals-index', count: deals.length }))}>
      {deals.length > 0 ? (
        <>
          <h2 class="rest-title">More this week</h2>
          <div class="deals-grid">
            {deals.map((deal, index) => <DealCard deal={deal} listId="deals-index" position={index} />)}
          </div>
        </>
      ) : (
        <div class="deals-empty">
          <h2 class="rest-title">Nothing else live right now</h2>
          <p>
            We list a deal only while its price actually holds, so this page runs empty
            between drops rather than padded with expired ones. The reviews behind the
            picks are the better read in the meantime.
          </p>
          <a class="more" href="/reviews">Read the reviews →</a>
        </div>
      )}
    </section>

    <div class="disclosure-wrap">
      <AffiliateDisclosure />
    </div>
  </div>
</BaseLayout>

<style>
  .deals-hero { padding: 48px 0 32px; }
  .rest-title {
    font-family: var(--font-display);
    font-size: 36px;
    letter-spacing: -0.02em;
    margin: 56px 0 24px;
    font-weight: 400;
    color: var(--ink);
  }
  .deals-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  @media (max-width: 900px) { .deals-grid { grid-template-columns: 1fr; } }
  .deals-empty { max-width: 56ch; }
  .deals-empty p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0 0 20px;
  }
  .deals-empty .more {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    padding-bottom: 4px;
    border-bottom: 1.5px solid var(--accent);
  }
  .disclosure-wrap { padding: 80px 0 32px; max-width: 68ch; }
</style>
