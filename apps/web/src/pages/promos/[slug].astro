---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/seo/Breadcrumbs.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import Button from '@components/ui/Button.astro';
import IconButton from '@components/ui/IconButton.astro';
import AffiliateDisclosure from '@components/affiliate/AffiliateDisclosure.astro';
import { promos, type Promo } from '@data/promos';
import { getCategoryBySlug } from '@data/categories';
import { buildMeta, buildOfferSchema } from '@lib/seo';
import { EVENTS } from '@lib/analytics';

export const getStaticPaths = (async () => {
  return promos.map((promo) => ({
    params: { slug: promo.slug },
    props: { promo },
  }));
}) satisfies GetStaticPaths;

interface Props { promo: Promo; }
const { promo } = Astro.props;
const category = getCategoryBySlug(promo.category);

const meta = buildMeta({
  title: `${promo.brand} promo code — ${promo.discountLabel}`,
  description: promo.description,
  pathname: `/promos/${promo.slug}`,
});
const schema = buildOfferSchema(promo, `/promos/${promo.slug}`, promo.title);
---
<BaseLayout
  {...meta}
  schema={schema}
  active="deals"
  screen="promo-detail"
  pageProps={{ category: promo.category, slug: promo.slug, brand: promo.brand }}
>
  <div class="container">
    <Breadcrumbs
      items={[
        { name: 'Home', href: '/' },
        { name: 'Promo codes', href: '/promos' },
        { name: promo.brand, href: `/promos/${promo.slug}` },
      ]}
    />
  </div>

  <article class="container promo-page">
    <header class="head">
      <div class="logo" aria-hidden="true">{promo.brandMark}</div>
      <Eyebrow accent>{promo.brand} · {category?.name ?? promo.category}</Eyebrow>
      <h1>{promo.title}</h1>
      <p class="dek">{promo.description}</p>
    </header>

    <section class="card">
      <div class="code-row">
        <div class="code-text">
          <span class="code-label">Copy code at checkout</span>
          <code>{promo.code}</code>
        </div>
        {/* The code is the one thing the visitor has to carry to the merchant's
            checkout, so it gets a control rather than asking them to select it
            by hand. Same flash acknowledgement as the article copy-link button;
            chrome.ts owns both. */}
        <IconButton
          title="Copy code"
          data={{
            'copy-code': promo.code,
            'track-props': JSON.stringify({ slug: promo.slug, brand: promo.brand }),
          }}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        </IconButton>
      </div>
      <p class="disc-label">{promo.discountLabel}</p>
      <Button
        href={promo.href}
        variant="accent"
        arrow
        rel="sponsored nofollow"
        data={{ track: EVENTS.affiliateClick, 'track-props': JSON.stringify({ slug: promo.slug, brand: promo.brand, placement: 'promo-detail' }) }}
      >
        Apply code at {promo.brand}
      </Button>
      <p class="terms"><strong>Terms.</strong> {promo.terms}</p>
      <p class="ends">{promo.ends}</p>
    </section>

    <AffiliateDisclosure />
  </article>
</BaseLayout>

<style>
  .promo-page { padding: 48px 0 96px; max-width: 720px; }
  .head { margin-bottom: 40px; }
  .logo {
    width: 72px;
    height: 72px;
    border-radius: 16px;
    background: var(--accent-soft);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 32px;
    margin-bottom: 20px;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(36px, 4.5vw, 56px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 500;
    color: var(--ink);
    margin: 12px 0 16px;
    max-width: none;
    text-wrap: balance;
  }
  .dek {
    font-size: 18px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 60ch;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--hairline-strong);
    border-radius: 20px;
    padding: 32px;
    margin: 32px 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .code-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 22px;
    background: var(--surface-2);
    border-radius: var(--r-md);
  }
  .code-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .code-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  code {
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 600;
    background: transparent;
    padding: 0;
    color: var(--ink);
  }
  .disc-label {
    font-family: var(--font-display);
    font-size: 32px;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
  }
  .terms { font-size: 13px; color: var(--muted); margin: 0; line-height: 1.55; }
  .terms strong { color: var(--ink); }
  .ends { font-size: 13px; color: var(--muted); margin: 0; }
</style>
