---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/seo/Breadcrumbs.astro';
import ListingHero from '@components/blog/ListingHero.astro';
import PromoCard from '@components/affiliate/PromoCard.astro';
import AffiliateDisclosure from '@components/affiliate/AffiliateDisclosure.astro';
import { getActivePromos } from '@data/promos';
import { buildCategorySchema, buildMeta } from '@lib/seo';
import { listViewProps } from '@lib/listing';

const promos = getActivePromos();

const desc =
  'Promo codes worth typing — checked monthly, dropped when they stop working. No "exclusive" theatre; just the codes that move the price.';

const meta = buildMeta({
  title: 'Promo codes',
  description: desc,
  pathname: '/promos',
  // Nothing to list yet: a thin page, kept out of the index until there is.
  noindex: promos.length === 0,
});
---
<BaseLayout
  {...meta}
  schema={buildCategorySchema('Promo codes', '/promos', desc)}
  active="deals"
  screen="promos-listing"
>
  <div class="container">
    <Breadcrumbs
      items={[
        { name: 'Home', href: '/' },
        { name: 'Deals', href: '/deals' },
        { name: 'Promo codes', href: '/promos' },
      ]}
    />
  </div>

  <ListingHero
    eyebrow="Codes · Verified monthly"
    titleHtml="Promo <em>codes</em>."
    dek={desc}
  />

  <div class="container">
    <div
      class="promo-grid"
      data-list-view={JSON.stringify(listViewProps({ listId: 'promos-index', count: promos.length }))}
    >
      {promos.map((promo, index) => <PromoCard promo={promo} listId="promos-index" position={index} />)}
    </div>

    <div class="disclosure-wrap">
      <AffiliateDisclosure />
    </div>
  </div>
</BaseLayout>

<style>
  .promo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    padding: 48px 0;
  }
  @media (max-width: 900px) { .promo-grid { grid-template-columns: 1fr; } }
  .disclosure-wrap { padding-bottom: 96px; max-width: 68ch; }
</style>
