        })}
      </div>
    </div>
  </LegalLayout>
</BaseLayout>

<script>
  // A changelog entry folded into a closed <details> has no box to scroll to.
  // Chromium opens it on fragment navigation by itself; this does the same
  // everywhere else, for a link arriving from another page and for in-page
  // links (run in the capture phase, ahead of the smooth-scroll handler).
  const openFoldFor = (id: string): boolean => {
    const target = id ? document.getElementById(id) : null;
    const fold = target?.closest<HTMLDetailsElement>('details[data-fold-anchors]');
    if (!fold || fold.open) return false;
    fold.open = true;
    return true;
  };
  const idOf = (hash: string): string => {
    try {
      return decodeURIComponent(hash.slice(1));
    } catch {
      return '';
    }
  };

  if (openFoldFor(idOf(location.hash))) document.getElementById(idOf(location.hash))?.scrollIntoView();
  window.addEventListener('hashchange', () => openFoldFor(idOf(location.hash)));
  document.addEventListener(
    'click',
    (event) => {
      const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[href^="#"]');
      if (link) openFoldFor(idOf(link.getAttribute('href') ?? ''));
    },
    true,
  );
</script>

