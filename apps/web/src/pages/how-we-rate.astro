---
import BaseLayout from '@layouts/BaseLayout.astro';
import LegalLayout from '@components/article/LegalLayout.astro';
import Button from '@components/ui/Button.astro';
import ChangelogList from '@components/methodology/ChangelogList.astro';
import ScoreChangeTable from '@components/methodology/ScoreChangeTable.astro';
import { categories } from '@data/categories';
import type { CategorySlug } from '@data/categories-types';
import { SCORE_CHANGES } from '@data/score-changes';
import { formatLong, formatMedium } from '@lib/format';
import {
  CHANGELOG_VISIBLE,
  INDEPENDENCE_RULES,
  NOT_TESTED_STATEMENT,
  SCORE_CHANGES_VISIBLE,
  SCORING_SUMMARY,
  badgeAnchor,
  bandRange,
  categoryAnchor,
  dayAsDate,
  foldNewestFirst,
  formatShare,
  methodChangelog,
  methodVersionAnchor,
  methodologyUpdated,
  nextVersions,
  publishedScoresEffect,
  scoreChangeCountLabel,
  scoreChangesNewestFirst,
  scoreDistribution,
  type MethodologySection,
} from '@lib/methodology';
import { getAllPosts } from '@lib/posts';
import { buildCategorySchema, buildMeta } from '@lib/seo';
import { FAST_REVIEW_INTERVAL_DAYS, reviewIntervalDays } from '@lib/sources';
import {
  BADGE_KINDS,
  BADGE_REGISTRY,
  CURRENT_METHOD_VERSION,
  FALLBACK_PROVENANCE,
  METHOD_VERSIONS,
  PROVENANCES,
  PROVENANCE_COPY,
  SCORE_BANDS,
  SUB_SCORE_TOLERANCE,
  badgeClaim,
  formatScore,
  methodLabel,
  reviewScoreClaim,
  scoreBand,
  type BadgeKind,
  type DealBadge,
} from '@lib/trust';

/**
 * The standing page every score and badge links to: what the scale means,
 * the scores we have actually given, how a product is assessed, the dated
 * method changelog, the badge glossary and the mechanism behind independence.
 *
 * Everything quotable is rendered from src/lib/trust.ts and
 * src/lib/methodology.ts rather than typed here, so the page cannot describe a
 * scale, provenance or badge the code does not apply. Every count, date and
 * state below is computed at build time, and each section has a designed state
 * for when there is nothing to count yet.
 */

const months = (days: number) => Math.round(days / 30);
const daysLabel = (days: number) => `${days} ${days === 1 ? 'day' : 'days'}`;
const joinList = (items: string[]) =>
  items.length <= 1 ? items.join('') : `${items.slice(0, -1).join(', ')} and ${items.at(-1)}`;

// --- Scores given -------------------------------------------------------------

const scored = (await getAllPosts()).flatMap((post) =>
  post.data.postType === 'review' && post.data.product ? [post.data.product.rating] : [],
);
const distribution = scoreDistribution(scored);
const hasScores = distribution.count > 0;
const modalBand = distribution.bands.reduce((top, entry) => (entry.count > top.count ? entry : top));
const skewsTop = hasScores && modalBand.band.id === SCORE_BANDS[0].id;
const builtOn = formatLong(new Date());

// --- The annotated example ----------------------------------------------------

const EXAMPLE_RATING = 4.4;
const exampleBand = scoreBand(EXAMPLE_RATING);
const currentVersion = METHOD_VERSIONS.find((entry) => entry.version === CURRENT_METHOD_VERSION)!;
const currentAnchor = methodVersionAnchor(CURRENT_METHOD_VERSION);

// --- Changelog and score changes ----------------------------------------------

const scoreChanges = scoreChangesNewestFirst(SCORE_CHANGES);
const changelog = methodChangelog().map((entry) => ({
  ...entry,
  effect: publishedScoresEffect(entry, distribution.count, scoreChanges.length),
}));
const versionLog = foldNewestFirst(changelog, CHANGELOG_VISIBLE);
const changeLog = foldNewestFirst(scoreChanges, SCORE_CHANGES_VISIBLE);
const updated = formatLong(dayAsDate(methodologyUpdated(METHOD_VERSIONS, scoreChanges)));
const next = nextVersions(CURRENT_METHOD_VERSION);
const plural = (count: number, one: string, many: string) => `${count} ${count === 1 ? one : many}`;
const NUMBER_WORDS = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const inWords = (count: number) => NUMBER_WORDS[count] ?? String(count);

// --- Badge glossary -----------------------------------------------------------

// Sample evidence for each kind's specimen, filled through the registry's own
// claim templates.
const SPECIMEN_DAY = '2026-10-02';
const specimens: { [K in BadgeKind]: Extract<DealBadge, { kind: K }> } = {
  'review-score': {
    kind: 'review-score',
    evidence: { reviewSlug: 'example-review', rating: EXAMPLE_RATING },
    checkedAt: SPECIMEN_DAY,
  },
  'honest-negative': {
    kind: 'honest-negative',
    evidence: { note: 'It was cheaper in July.' },
    checkedAt: SPECIMEN_DAY,
  },
  'lowest-price': {
    kind: 'lowest-price',
    evidence: { price: 'A$449', previousLowest: 'A$479', observations: 12 },
    checkedAt: SPECIMEN_DAY,
  },
  'below-average': {
    kind: 'below-average',
    evidence: { price: 'A$408', average: 'A$449', below: 'A$41', observations: 30 },
    checkedAt: SPECIMEN_DAY,
  },
};

const scoreWindow = BADGE_REGISTRY['review-score'].windowDays;
const skipWindow = BADGE_REGISTRY['honest-negative'].windowDays;

/**
 * What each kind claims, what is checked, over what window and when it comes
 * down. Typed against the registry, so a kind added there cannot reach a page
 * without this glossary saying what it means.
 */
const glossary: Record<BadgeKind, { claims: string; checks: string; window: string; expires: string; needs: string; issued?: string }> = {
  'review-score': {
    claims: 'This is the score our review gave the product, and the band it falls in.',
    checks: 'That the review is published and the score matches it exactly. The badge links to the review.',
    window: `As long as the review is inside its re-check cadence: ${months(scoreWindow)} months, or ${months(FAST_REVIEW_INTERVAL_DAYS)} months in the faster-moving categories.`,
    expires: 'When the review falls overdue for its re-check, is re-scored, or is withdrawn.',
    needs: 'a published review',
  },
  'honest-negative': {
    claims: "The product may be good, but we would hold off buying at today's price, for the reason written in the badge.",
    checks: 'That a person checked the price on the date the badge prints, and wrote down why we are saying skip.',
    window: `${daysLabel(skipWindow)} from the check date, which the badge always prints.`,
    expires: `${daysLabel(skipWindow)} after the check. A price call goes stale fast, so it never reads as permanent.`,
    needs: 'a dated price check',
    issued: 'Issued, used rarely',
  },
  'lowest-price': {
    claims: "No price we recorded for this product in the last 90 days was lower than today's.",
    checks: "Today's price, the lowest earlier price, and at least two recorded price checks inside the 90 days.",
    window: 'The 90 days of recorded price checks before today.',
    expires: `${daysLabel(BADGE_REGISTRY['lowest-price'].windowDays)} after the check, because a price can move the next day.`,
    needs: 'a dated record of prices over time',
  },
  'below-average': {
    claims: "Today's price is this many dollars under the average of the prices we recorded over 30 days.",
    checks: "Today's price, the average, and at least two recorded price checks the average is worked out from.",
    window: 'The 30 days of recorded price checks before today.',
    expires: `${daysLabel(BADGE_REGISTRY['below-average'].windowDays)} after the check, because a price can move the next day.`,
    needs: 'a dated record of prices over time',
  },
};

const badgeKinds = BADGE_KINDS.map((kind) => BADGE_REGISTRY[kind]);
const issuedLabels = badgeKinds.filter((badge) => badge.enabled).map((badge) => badge.label);
const offKinds = badgeKinds.filter((badge) => !badge.enabled);
const offNeeds = [...new Set(offKinds.map((badge) => glossary[badge.kind].needs))];

// --- Page ---------------------------------------------------------------------

const toc: { id: MethodologySection | 'summary'; label: string }[] = [
  { id: 'summary', label: 'Plain summary' },
  { id: 'bands', label: 'The scale' },
  { id: 'distribution', label: 'Scores we have given' },
  { id: 'assessment', label: 'How we assess products' },
  { id: 'changelog', label: 'Method changelog' },
  { id: 'badges', label: 'Badge glossary' },
  { id: 'independence', label: 'Independence' },
  { id: 'corrections', label: 'Corrections and score changes' },
  { id: 'categories', label: 'By category' },
];

const meta = buildMeta({
  title: 'How we rate',
  description:
    'What a SleekDrops score means: the five bands, every score we have given, how products are assessed (we do not test them), the dated method changelog, the badge glossary and how independence is enforced.',
  pathname: '/how-we-rate',
});
---
<BaseLayout
  {...meta}
  schema={buildCategorySchema('How we rate', '/how-we-rate', meta.description)}
  active="how-we-rate"
  screen="how-we-rate"
>
  <LegalLayout
    eyebrow="Scoring method"
    titleHtml="How we <em>rate</em>."
    updated={updated}
    toc={toc.map((item) => ({ href: `#${item.id}`, label: item.label }))}
  >
    <div class="method-line" slot="hero">
      <a class="method-chip" href={`#${currentAnchor}`}>
        <b>{methodLabel(CURRENT_METHOD_VERSION)}</b>
        <span class="sep" aria-hidden="true">·</span>
        <span>in effect since {formatMedium(dayAsDate(currentVersion.date))}</span>
      </a>
    </div>

    <div class="rate">
      <div class="summary" id="summary">
        <strong>Plain summary</strong>
        {SCORING_SUMMARY} Each one links back to this page.{' '}
        {!hasScores
          ? 'Most products we write up tend to score highly; once reviews are scored, the distribution below will show exactly how highly, so you can read any score in context.'
          : skewsTop
            ? `Most products we write up score highly, and the distribution below shows exactly how highly, so you can read a ${formatScore(EXAMPLE_RATING)} in context.`
            : `The distribution below shows how our scores spread, so you can read a ${formatScore(EXAMPLE_RATING)} in context.`}
        <div class="anatomy">
          <div class="anatomy-score" role="img" aria-label={`Example: ${formatScore(EXAMPLE_RATING)} out of 5, band ${exampleBand.label}`}>
            <span class="anatomy-num" aria-hidden="true">{formatScore(EXAMPLE_RATING)}<sup>&nbsp;/5</sup></span>
            <span class="band-word" aria-hidden="true">{exampleBand.label}</span>
          </div>
          <div class="anatomy-meta">
            <a href={`#${currentAnchor}`}>{methodLabel(CURRENT_METHOD_VERSION)}</a>
            <a href="#assessment">{PROVENANCE_COPY[FALLBACK_PROVENANCE].label}</a>
            <span>Reviewed {formatMedium(dayAsDate(currentVersion.date))}</span>
          </div>
          <ol class="anatomy-key">
            <li><span class="n" aria-hidden="true">1</span><span><b>The score.</b> Out of 5, in tenths. The denominator is always shown.</span></li>
            <li><span class="n" aria-hidden="true">2</span><span><b>The band.</b> One word for what the number means. <a href="#bands">See the scale</a>.</span></li>
            <li><span class="n" aria-hidden="true">3</span><span><b>The method version.</b> Which rules the score was given under. <a href="#changelog">See the changelog</a>.</span></li>
            <li><span class="n" aria-hidden="true">4</span><span><b>How we got the product.</b> Today the answer is always: we did not hold it. <a href="#assessment">See how we assess</a>.</span></li>
          </ol>
        </div>
      </div>

      <h2 id="bands">The <em>scale</em></h2>
      <p>Five bands, each with one word and what it means for you. They are written for the way we actually score, which is generously at the top: we mostly research products that independent coverage has already shortlisted, so a weak score here is rare and worth taking seriously.</p>
      <table class="bands">
        <thead><tr><th scope="col">Score</th><th scope="col">Band</th><th scope="col">What it means</th></tr></thead>
        <tbody>
          {SCORE_BANDS.map((band) => (
            <tr id={`band-${band.id}`} class:list={{ 'is-example': band.id === exampleBand.id }}>
              <td class="range">{bandRange(band)}</td>
              <td class="label"><span class="band-word">{band.label}</span></td>
              <td class="meaning"><strong>{band.meaning}</strong></td>
            </tr>
          ))}
        </tbody>
      </table>
      <p>Read the band and the written verdict together. A decimal is a summary, not a measurement, and the difference between 4.6 and 4.7 is a judgement call rather than a gap you could test.</p>

      <h2 id="distribution">Scores we have <em>given</em></h2>
      <p>
        {!hasScores
          ? 'Once reviews are scored and published, this section shows the spread of scores by band, counted the same way. Nothing is scored yet, so there is nothing to count.'
          : skewsTop
            ? 'Our average is high, and we would rather show you why than let it sit unexplained. This is every published review score, by band, counted when the site was last built.'
            : 'This is every published review score, by band, counted when the site was last built.'}
      </p>
      <figure class="dist">
        <div class="dist-head">
          <h3>Published review scores, by band</h3>
          <div class="dist-stats">
            <span><b>{distribution.count}</b> {distribution.count === 1 ? 'review' : 'reviews'}</span>
            {distribution.average !== undefined && <span>average <b>{formatScore(distribution.average)}</b></span>}
            {distribution.median !== undefined && <span>median <b>{formatScore(distribution.median)}</b></span>}
          </div>
        </div>
        {hasScores ? (
          <>
            <ul class="dist-rows">
              {distribution.bands.map(({ band, count, share }) => (
                <li class="dist-row">
                  <span class="who"><b>{band.label}</b><span>{bandRange(band)}</span></span>
                  <span class="dist-track" aria-hidden="true">
                    {count > 0 && <span class="dist-bar" style={`--w:${(share * 100).toFixed(1)}%`} />}
                  </span>
                  <span class="val">{count} <span>· {formatShare(share)}</span></span>
                </li>
              ))}
            </ul>
            <figcaption class="dist-foot">
              {formatShare(modalBand.share)} of reviews land in the {modalBand.band.label} band.{' '}
              {skewsTop && 'That is mostly selection: we start from products that independent testers already rate, so we rarely write up one we would tell you to avoid. It also means the band, not the decimal, is what separates a strong pick from an excellent one. '}
              Counted from all {plural(distribution.count, 'published review', 'published reviews')} on {builtOn}.
            </figcaption>
          </>
        ) : (
          <div class="dist-empty">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h16" /><path d="M7 16V9" /><path d="M12 16V5" /><path d="M17 16v-4" /></svg>
            <div>
              <p>No scored reviews are published yet.</p>
              <p>The spread of scores appears here as soon as the first review with a score goes live.</p>
            </div>
          </div>
        )}
      </figure>

      <h2 id="assessment">How we assess <em>products</em></h2>
      <p class="plain-statement">{NOT_TESTED_STATEMENT}</p>
      <p>Every review states how we got the product, at the top and again next to its score. There are three possible answers, and these are the exact words a review uses:</p>
      <ul class="prov-list">
        {PROVENANCES.map((provenance, index) => (
          <li class:list={['prov-item', { 'is-current': provenance === FALLBACK_PROVENANCE }]}>
            <span class="k">{String(index + 1).padStart(2, '0')}</span>
            <span class="v">
              <strong>{PROVENANCE_COPY[provenance].label}</strong>
              <span>{PROVENANCE_COPY[provenance].statement}</span>
              {provenance === FALLBACK_PROVENANCE && <span class="prov-now">What a review says today</span>}
            </span>
          </li>
        ))}
      </ul>
      <p>A review that records nothing falls back to {PROVENANCE_COPY[FALLBACK_PROVENANCE].label}, because claiming a unit we never held is the failure we most want to avoid. The full evidence standard, including which sources count and how often we re-check them, is on <a href="/how-we-research">how we research</a>.</p>
      <p>We give one score and explain it in writing. When a review also shows a breakdown into weighted sub-scores, the weights add up to 100% and the breakdown works out to the headline score to within {SUB_SCORE_TOLERANCE}. A breakdown that does not add up cannot be published.</p>

      <h2 id="changelog">Method <em>changelog</em></h2>
      <p>Every score records the method version it was given under. When the method changes, the version number changes and the change is logged here with its date. Old scores keep their version, so a score from last year is never silently re-judged by this year's rules.</p>
      <table class="version-rules">
        <thead><tr><th scope="col">Version step</th><th scope="col">What triggers it</th><th scope="col">What happens to published scores</th></tr></thead>
        <tbody>
          <tr>
            <td><code>{CURRENT_METHOD_VERSION} → {next.major}</code></td>
            <td data-label="What triggers it">A change to the bands, to what a score weighs, or to the order those things count in.</td>
            <td data-label="What happens to published scores">They keep their old version. A review is re-scored only when it is next re-checked, and is then labelled with the new version and its old score.</td>
          </tr>
          <tr>
            <td><code>{CURRENT_METHOD_VERSION} → {next.minor}</code></td>
            <td data-label="What triggers it">A clearer explanation, a new category section, or a fix to this page that changes no score.</td>
            <td data-label="What happens to published scores">Nothing. No score can move in a minor version.</td>
          </tr>
        </tbody>
      </table>
      <ChangelogList entries={versionLog.recent} />
      {versionLog.older.length > 0 && (
        <details class="fold log-older" data-fold-anchors>
          <summary>
            <span class="fold-label">
              Show {plural(versionLog.older.length, 'earlier version', 'earlier versions')}
              <span class="meta">v{versionLog.older[0].version}{versionLog.older.length > 1 && ` – v${versionLog.older.at(-1)!.version}`}</span>
            </span>
            <span class="chev" aria-hidden="true"><svg viewBox="0 0 12 12"><path d="M2 4l4 4 4-4" /></svg></span>
          </summary>
          <ChangelogList entries={versionLog.older} nested />
        </details>
      )}

      <h2 id="badges">Badge <em>glossary</em></h2>
      <p>Every badge on SleekDrops is a statement of fact we can check, never an endorsement word. There are {inWords(badgeKinds.length)} kinds. Here is each one: what it claims, what we check before it appears, over what window, and when it comes down.</p>
      {offKinds.length > 0 && (
        <p class="off-note">
          <strong>Not currently issued: {joinList(offKinds.map((badge) => badge.label))}.</strong>{' '}
          {offKinds.length === 1 ? 'It needs' : 'They need'} {joinList(offNeeds)}, and we do not keep one yet. Until we do, the badges you can see are {joinList(issuedLabels)}. The others are listed so you know exactly what they will mean when they appear.
        </p>
      )}
      <ul class="badges">
        {badgeKinds.map((badge) => (
          <li class:list={['badge-entry', { 'is-off': !badge.enabled }]} id={badgeAnchor(badge.kind)}>
            <div class="badge-top">
              {badge.kind === 'review-score' ? (
                <span class="sd-badge" role="img" aria-label={`${reviewScoreClaim(EXAMPLE_RATING)}, ${exampleBand.label}`}>
                  <span class="num" aria-hidden="true">{formatScore(EXAMPLE_RATING)}<small>/5</small></span>
                  <span aria-hidden="true">{reviewScoreClaim(EXAMPLE_RATING).replace(`${formatScore(EXAMPLE_RATING)}/5`, '').trim()}</span>
                  <span class="band" aria-hidden="true">{exampleBand.label}</span>
                </span>
              ) : (
                <span class:list={['sd-badge', badge.kind === 'honest-negative' ? 'sd-badge--skip' : 'sd-badge--price']}>
                  {badge.kind === 'honest-negative' && (
                    <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6" /><path d="M8 5v3.5" /><path d="M8 11h.01" /></svg>
                  )}
                  {badge.kind === 'lowest-price' && (
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4l5 5 3-3 4 4" /></svg>
                  )}
                  {badge.kind === 'below-average' && (
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v11" /><path d="M4 9l4 4 4-4" /></svg>
                  )}
                  {badgeClaim(specimens[badge.kind])}
                </span>
              )}
              {badge.enabled ? (
                <span class="status status--live">
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3 3 7-7" /></svg>{glossary[badge.kind].issued ?? 'Issued'}
                </span>
              ) : (
                <span class="status status--off">
                  <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6" /><path d="M4 12l8-8" /></svg>Not currently issued
                </span>
              )}
            </div>
            <h3>{badge.label}</h3>
            <dl class="facts">
              <dt>Claims</dt><dd>{glossary[badge.kind].claims}</dd>
              <dt>We check</dt><dd>{glossary[badge.kind].checks}</dd>
              <dt>Window</dt><dd>{glossary[badge.kind].window}</dd>
              <dt>Expires</dt><dd>{glossary[badge.kind].expires}</dd>
            </dl>
          </li>
        ))}
      </ul>
      <div class="tag-note">
        <h3>The commission tag is not a badge</h3>
        <span class="sd-badge sd-badge--disclosure">We earn a commission on this deal</span>
        <p>It sits beside deals and buy buttons because we are paid if you buy through that link. It is a disclosure, not an endorsement, and it never affects a score. Links that earn us nothing carry no tag.</p>
      </div>

      <h2 id="independence"><em>Independence</em>, and how it works</h2>
      <p>A promise of independence is easy to make. These are the {inWords(INDEPENDENCE_RULES.length)} rules that make ours, and what each one means in practice.</p>
      <ul class="mech">
        {INDEPENDENCE_RULES.map((rule, index) => (
          <li>
            <span class="num">{String(index + 1).padStart(2, '0')}</span>
            <h3>{rule.title}</h3>
            <p>{rule.statement}</p>
            <span class="check"><b>{rule.proof.label}</b>{rule.proof.text}</span>
          </li>
        ))}
      </ul>

      <h2 id="corrections">Corrections and <em>score changes</em></h2>
      <p>If we have a fact wrong, we want to fix it rather than defend it. Reporting one takes three things:</p>
      <ol class="report">
        <li><b>The article</b>Its title or link.</li>
        <li><b>The claim</b>The sentence or figure you think is wrong.</li>
        <li><b>Your source</b>Where the right figure is published, if you have it.</li>
      </ol>
      <div class="report-actions">
        <Button href="mailto:corrections@sleekdrops.com?subject=Correction" arrow>Report an error</Button>
        <Button href="#score-changes" variant="outline">See score changes</Button>
      </div>
      <p>Email goes to <a href="mailto:corrections@sleekdrops.com">corrections@sleekdrops.com</a>. We correct a confirmed error as soon as we can, note the change on the article, and re-stamp its review date. When a correction or a re-check moves a score, the change is listed here with the old score, the new one, the date and the reason.</p>

      <section class="changes" id="score-changes" aria-labelledby="score-changes-title">
        <div class="changes-head">
          <h3 id="score-changes-title">Score-change log</h3>
          <span>{scoreChangeCountLabel(scoreChanges.length)}</span>
        </div>
        {scoreChanges.length === 0 ? (
          <div class="changes-empty">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M8 12.5l2.5 2.5L16 9.5" /></svg>
            <div>
              <p>No published score has changed since {methodLabel(METHOD_VERSIONS[0].version)} took effect.</p>
              <p>Every future change is listed here with the old score, the new one, the date and the reason.</p>
            </div>
          </div>
        ) : (
          <>
            <ScoreChangeTable changes={changeLog.recent} />
            <div class="scroll-hint">Scroll sideways to see the reason.</div>
            {changeLog.older.length > 0 && (
              <details class="fold changes-more">
                <summary>
                  <span class="fold-label">Show {plural(changeLog.older.length, 'earlier change', 'earlier changes')}</span>
                  <span class="chev" aria-hidden="true"><svg viewBox="0 0 12 12"><path d="M2 4l4 4 4-4" /></svg></span>
                </summary>
                <ScoreChangeTable changes={changeLog.older} />
              </details>
            )}
          </>
        )}
      </section>

      <h2 id="categories">By <em>category</em></h2>
      <p>The method above applies to every category in full. Each category also gets its own section here, which will become its own page as its notes grow. Link to any of them directly.</p>
      <div class="cats">
        {categories.map((category) => {
          const anchor = categoryAnchor(category.slug as CategorySlug);
          return (
            <section class="cat" id={anchor} aria-labelledby={`${anchor}-title`}>
              <div class="cat-head">
                <h3 id={`${anchor}-title`}>{category.name}</h3>
                <a class="cat-anchor" href={`#${anchor}`} aria-label={`Link to the ${category.name} section`}>#{anchor}</a>
              </div>
              <p>{category.blurb}</p>
              <span class="cadence">Re-checked every {months(reviewIntervalDays(category.name))} months</span>
