---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/seo/Breadcrumbs.astro';
import ListingHero from '@components/blog/ListingHero.astro';
import PostGrid from '@components/blog/PostGrid.astro';
import { listAuthors, type Author } from '@data/authors';
import { getPostsByAuthor, type BlogPost } from '@lib/posts';
import { buildAuthorSchema, buildMeta } from '@lib/seo';

export const getStaticPaths = (async () => {
  return listAuthors().map((author) => ({
    params: { author: author.id },
    props: { author },
  }));
}) satisfies GetStaticPaths;

interface Props { author: Author; }
const { author } = Astro.props;
const posts: BlogPost[] = await getPostsByAuthor(author.id);

// "SleekDrops Tech Desk" with the masthead italicised, whatever the desk is
// called. Escaped because the hero renders it with set:html.
const escape = (value: string) =>
  value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const titleHtml = author.name.startsWith('SleekDrops ')
  ? `<em>SleekDrops</em> ${escape(author.name.slice('SleekDrops '.length))}`
  : escape(author.name);

const meta = buildMeta({
  title: `${author.name} — ${author.role}`,
  description: author.bio,
  pathname: `/author/${author.id}`,
  // A desk that has not published yet has an archive with nothing in it, which
  // is a thin page however accurate its bio. Noindex until it lists something;
  // the sitemap leaves the same pages out, on the same test.
  noindex: posts.length === 0,
});
---
<BaseLayout
  {...meta}
  schema={buildAuthorSchema(author)}
  screen="author"
  pageProps={{ slug: author.id }}
>
  <div class="container">
    <Breadcrumbs
      items={[
        { name: 'Home', href: '/' },
        { name: 'About', href: '/about' },
        { name: author.name, href: `/author/${author.id}` },
      ]}
    />
  </div>

  <ListingHero
    eyebrow={author.role}
    titleHtml={titleHtml}
    dek={author.bio}
    stats={[
      { num: String(posts.length), lbl: 'Posts' },
    ]}
  />

  <div class="container">
    {posts.length === 0 ? (
      <p class="empty">No posts from {author.name} yet.</p>
    ) : (
      <div class="grid">
        <PostGrid posts={posts} columns={3} />
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .grid { padding: 48px 0 96px; }
  .empty {
    padding: 96px 0;
    text-align: center;
    color: var(--muted);
    font-size: 16px;
  }
</style>
