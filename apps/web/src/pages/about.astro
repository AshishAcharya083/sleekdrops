---
import BaseLayout from '@layouts/BaseLayout.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import { listAuthors, listBeats, authorInitials } from '@data/authors';
import { SITE_DESCRIPTION } from '@data/site';
import { getAllPosts } from '@lib/posts';
import { buildCategorySchema, buildMeta } from '@lib/seo';

const team = listAuthors();
// Beats are labels on the one byline, never separate mastheads: naming a desk
// promises a staffed team behind it, and inventing that team is exactly what
// costs an affiliate site its standing.
const beatLabels = listBeats()
  .map((beat) => beat.label)
  .filter(Boolean);
// The one number on this page we can stand behind: it is counted, not claimed.
const published = (await getAllPosts()).length;

const meta = buildMeta({
  title: 'About SleekDrops',
  description: SITE_DESCRIPTION,
  pathname: '/about',
});
---
<BaseLayout
  {...meta}
  schema={buildCategorySchema('About SleekDrops', '/about', meta.description)}
  active="about"
  screen="about"
>
  <section class="about-hero">
    <div class="container">
      <Eyebrow>About SleekDrops</Eyebrow>
      <h1>A buying guide you'd <em>actually</em> pay for.</h1>
      <p class="lede">{meta.description}</p>
    </div>
  </section>

  <section class="principles">
    <div class="container">
      <h2>Three rules we don't <em>break</em>.</h2>
      <div class="principles-grid">
        <div class="principle">
          <span class="num">01 / Independence</span>
          <h3>No <em>paid</em> placements. Ever.</h3>
          <p>No brand pays for a place on this site. We don't take sponsorships, we don't run "promoted" posts, and no brand sees a piece before it's published. We earn a commission when you buy through our links, and that never decides what we recommend.</p>
        </div>
        <div class="principle">
          <span class="num">02 / Method</span>
          <h3>If we can't <em>source</em> it, we don't say it.</h3>
          <p>We research; we do not test products. Every pick is an editorial synthesis of published test results, manufacturer specs and owner reports, compared against its nearest competitors, with Australian availability checked on the date shown. No article here is written from hands-on use, and every one of them lists the sources it used. The full method is in <a href="/how-we-research">how we research</a>.</p>
        </div>
        <div class="principle">
          <span class="num">03 / Honesty</span>
          <h3>The <em>cons</em> column is always full.</h3>
          <p>Every product has flaws. Our coverage surfaces them — 2 to 4 honest disadvantages, always. If we can't find any, we haven't looked hard enough yet.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="accountability">
    <div class="container accountability-grid">
      <div>
        <Eyebrow>Publisher accountability</Eyebrow>
        <h2>Who is responsible for <em>SleekDrops</em>.</h2>
      </div>
      <div>
        <p><strong>SleekDrops is an independently operated Australian digital publication.</strong> The SleekDrops Editorial Team is the accountable publisher byline for every article; beat labels describe subject coverage, not invented people or credentials. Articles are AI-assisted and human-reviewed, which is set out in full in our <a href="/ai-disclosure">AI-assistance disclosure</a>.</p>
        <p>Corrections are handled at <a href="mailto:corrections@sleekdrops.com">corrections@sleekdrops.com</a>, editorial questions at <a href="mailto:desk@sleekdrops.com">desk@sleekdrops.com</a>, and privacy requests at <a href="mailto:privacy@sleekdrops.com">privacy@sleekdrops.com</a>.</p>
      </div>
    </div>
  </section>

  <section class="team">
    <div class="container">
      <div class="team-head">
        <h2>The <em>team</em>.</h2>
        <p>Research-led coverage published under one accountable team byline, tagged with the beat it was written on: {beatLabels.join(', ')}. Beats are labels, not separate mastheads: no invented authors and no claimed hands-on testing.</p>
      </div>
      <div class="team-grid">
        {team.map((author) => (
          <a class="member" href={`/author/${author.id}`}>
            <div class="avatar" aria-hidden="true">{authorInitials(author)}</div>
            <span class="role">{author.role}</span>
            <h4>{author.name}</h4>
            <p>{author.bio}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="stats-band">
    <div class="container">
      <Eyebrow accent dot>The numbers</Eyebrow>
      <h2>Independent, and paid only when <em>you</em> buy.</h2>
      <div class="row">
        <div><div class="num">{published}</div><div class="lbl">Articles published</div></div>
        <div><div class="num"><em>0</em></div><div class="lbl">Paid placements</div></div>
        <div><div class="num"><em>0</em></div><div class="lbl">Brand-supplied products</div></div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero { padding: 80px 0 64px; border-bottom: 1px solid var(--hairline); }
  .about-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(64px, 9vw, 128px);
    line-height: 0.95;
    letter-spacing: -0.035em;
    font-weight: 400;
    color: var(--ink);
    margin: 16px 0 32px;
    max-width: 16ch;
  }
  .about-hero h1 em { font-style: italic; color: var(--accent); }
  .about-hero .lede {
    font-size: 24px;
    line-height: 1.5;
    color: var(--muted);
    max-width: 56ch;
  }

  .principles { padding: 80px 0; border-bottom: 1px solid var(--hairline); }
  .principles h2 {
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 64px);
    letter-spacing: -0.025em;
    font-weight: 400;
    color: var(--ink);
    margin: 0 0 48px;
    max-width: 18ch;
  }
  .principles h2 em { font-style: italic; }
  .principles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  @media (max-width: 900px) { .principles-grid { grid-template-columns: 1fr; } }
  .principle { padding-top: 24px; border-top: 1px solid var(--ink); }
  .principle .num {
    font-family: var(--font-display);
    font-size: 13px;
    color: var(--accent);
    letter-spacing: 0.1em;
  }
  .principle h3 {
    font-family: var(--font-display);
    font-size: 28px;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 16px 0 12px;
    font-weight: 400;
    line-height: 1.15;
  }
  .principle h3 em { font-style: italic; }
  .principle p {
    font-size: 15px;
    line-height: 1.65;
    color: var(--muted);
    margin: 0;
  }

  .team { padding: 80px 0; border-bottom: 1px solid var(--hairline); }
  .accountability { padding: 72px 0; border-bottom: 1px solid var(--hairline); }
  .accountability-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; }
  .accountability h2 { font-family: var(--font-display); font-size: clamp(38px, 4vw, 56px); line-height: 1.05; font-weight: 400; color: var(--ink); margin: 14px 0 0; }
  .accountability h2 em { font-style: italic; }
  .accountability p { margin: 0 0 16px; color: var(--muted); font-size: 16px; line-height: 1.65; }
  .accountability strong, .accountability a { color: var(--ink); }
  @media (max-width: 900px) { .accountability-grid { grid-template-columns: 1fr; gap: 28px; } }
  .team-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 40px;
    gap: 24px;
    flex-wrap: wrap;
  }
  .team-head h2 {
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 64px);
    letter-spacing: -0.025em;
    font-weight: 400;
    color: var(--ink);
    margin: 0;
  }
  .team-head h2 em { font-style: italic; }
  .team-head p {
    font-size: 14px;
    color: var(--muted);
    max-width: 30ch;
    margin: 0;
  }
  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  @media (max-width: 900px) { .team-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .team-grid { grid-template-columns: 1fr; } }
  .member {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    border: 1px solid var(--hairline);
    border-radius: 16px;
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }
  .member:hover {
    border-color: var(--hairline-strong);
    box-shadow: var(--shadow-md);
    color: inherit;
  }
  .member .avatar {
    width: 56px;
    height: 56px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 20px;
    margin-bottom: 8px;
  }
  .member h4 {
    font-family: var(--font-display);
    font-size: 22px;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0;
    font-weight: 400;
  }
  .member .role {
    font-size: 12px;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 700;
  }
  .member p {
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
    margin: 4px 0 0;
  }

  .stats-band {
    padding: 96px 0;
    text-align: center;
    background: var(--surface-2);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .stats-band h2 {
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 72px);
    letter-spacing: -0.03em;
    font-weight: 400;
    color: var(--ink);
    margin: 24px auto 56px;
    max-width: 22ch;
    line-height: 1;
  }
  .stats-band h2 em { font-style: italic; }
  .stats-band .row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    max-width: 920px;
    margin: 0 auto;
  }
  @media (max-width: 700px) { .stats-band .row { grid-template-columns: repeat(2, 1fr); } }
  .stats-band .num {
    font-family: var(--font-display);
    font-size: 64px;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .stats-band .num em { font-style: italic; color: var(--accent); }
  .stats-band .lbl {
    font-size: 12px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-weight: 700;
    margin-top: 8px;
  }
</style>
