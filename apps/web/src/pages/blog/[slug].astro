---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/seo/Breadcrumbs.astro';
import Badge from '@components/ui/Badge.astro';
import IconButton from '@components/ui/IconButton.astro';
import ArticleBody from '@components/article/ArticleBody.astro';
import EvidenceRail from '@components/article/EvidenceRail.astro';
import Sources from '@components/article/Sources.astro';
import TrustStack from '@components/article/TrustStack.astro';
import Verdict from '@components/article/Verdict.astro';
import TableOfContents from '@components/article/TableOfContents.astro';
import AdUnit from '@components/ads/AdUnit.astro';
import AffiliateDisclosure from '@components/affiliate/AffiliateDisclosure.astro';
import ProsConsList from '@components/affiliate/ProsConsList.astro';
import ProductCallout from '@components/affiliate/ProductCallout.astro';
import AuthorCard from '@components/blog/AuthorCard.astro';
import RelatedPosts from '@components/blog/RelatedPosts.astro';
import { getAllPosts, getRelatedPosts, type BlogPost } from '@lib/posts';
import { authorInitials, getAuthor } from '@data/authors';
import { getCategory } from '@data/categories';
import { buildFaqSchema, buildMeta, buildPostSchema, extractFaq } from '@lib/seo';
import { emphasiseLastWord, formatLong, formatMedium, formatMonth } from '@lib/format';
import { reviewStatus, sourceCountLabel } from '@lib/sources';

export const getStaticPaths = (async () => {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}) satisfies GetStaticPaths;

interface Props { post: BlogPost; }
const { post } = Astro.props;

const { Content, headings } = await post.render();
const author = getAuthor(post.data.author);
const category = getCategory(post.data.category);
const product = post.data.product;
const related = await getRelatedPosts(post, 3);
const headlineHtml = emphasiseLastWord(post.data.title);
const stampYear = new Date(post.data.pubDate).getFullYear();
// The disclosure has to be visible alongside the links it disclosed, so it goes
// under the byline on any page that carries one - which is every pipeline post,
// and any hand-written one with a /go/ link in the body.
const hasAffiliateLinks = product !== undefined || /\/go\//.test(post.body);
const highStakes = post.data.category === 'Health' || post.data.category === 'Finance';

const meta = buildMeta({
  title: post.data.title,
  description: post.data.dek,
  pathname: `/blog/${post.slug}`,
  image: post.data.heroImage,
  type: 'article',
});
// One linked @graph per post: publisher, site, page, byline and article, plus
// the ItemList of picks on a guide or roundup and the Product/Review pair on a
// review post. The rendered headings go in so each pick can point at the
// section that recommends it — they carry the ids Astro actually emitted.
//
// The visible FAQ section is what answer engines quote; the FAQPage markup
// read back out of it is valid and harmless but no longer a Google rich result
// (removed May 2026), so it ships as-is rather than being relied on. Posts
// without an FAQ section (most of the older hand-written pieces) emit no block.
const schema = [buildPostSchema(post, author, headings), buildFaqSchema(extractFaq(post.body))];
// What the collapsed rail says on a phone, so the reader knows what is behind
// it before opening it.
const review = reviewStatus(post.data);
// The cadence is a per-category commitment, so the piece states when its own
// next check falls due rather than leaving it to the methodology page. Only
// while that date is still ahead: once it has passed, the review stamp says how
// long ago the last check was, which is the fact a reader can act on.
const nextCheck = review.due ? undefined : formatMonth(review.nextDue);
const asideSummary = [
  post.data.sources?.length ? sourceCountLabel(post.data.sources.length) : 'sources inline',
  `${review.inferred ? 'updated' : 'reviewed'} ${formatMedium(review.date)}`,
].join(' · ');
---
<BaseLayout
  {...meta}
  schema={schema}
  active="blog"
  progress
  screen="blog-post"
  pageProps={{ category: post.data.category, slug: post.slug }}
>
  <div class="container">
    <Breadcrumbs
      items={[
        { name: 'Home', href: '/' },
        { name: 'Blog', href: '/blog' },
        ...(category ? [{ name: category.name, href: `/category/${category.slug}` }] : []),
        { name: post.data.title, href: `/blog/${post.slug}` },
      ]}
    />
  </div>

  <article class="container">
    <header class="article-head">
      <div class="badges">
        <Badge variant="cat">{post.data.category}</Badge>
        {post.data.kind && <Badge variant="ink">{post.data.kind}</Badge>}
      </div>
      <h1 set:html={headlineHtml} />
      <p class="lede">{post.data.dek}</p>

      <div class="article-meta">
        <a class="avatar" href={`/author/${author.id}`} aria-hidden="true">{authorInitials(author)}</a>
        <div>
          <a class="author" href={`/author/${author.id}`}>{author.name}</a>
          <div class="author-role">{author.beat ? `${author.role} · ${author.beat}` : author.role}</div>
        </div>
        <span class="dot" aria-hidden="true" />
        <span class="stat">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          {formatLong(post.data.pubDate)}
        </span>
        <span class="dot" aria-hidden="true" />
        <span class="stat">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          {post.data.readTime} min read
        </span>
        <div class="actions">
          <IconButton title="Share" data={{ share: 'true', 'share-title': post.data.title, 'share-text': post.data.dek }}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
          </IconButton>
          <IconButton title="Copy link" data={{ 'copy-link': 'true' }}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          </IconButton>
        </div>
      </div>

      <TrustStack
        pubDate={post.data.pubDate}
        updatedDate={post.data.updatedDate}
        lastReviewed={post.data.lastReviewed}
        category={post.data.category}
        reviewedBy={author.name}
      />

      {hasAffiliateLinks && <AffiliateDisclosure variant="inline" />}

      <div
        class:list={['hero-image', !post.data.heroImage && 'fill', !post.data.heroImage && post.data.cover, post.data.heroImage && 'is-zoomable']}
        {...post.data.heroImage ? { 'data-lightbox': 'true' } : {}}
      >
        {post.data.heroImage
          ? <img src={post.data.heroImage} alt={post.data.heroAlt ?? post.data.title} loading="eager" />
          : <span class="markstamp">SleekDrops studio · {stampYear}</span>}
      </div>
    </header>

    <div class="article-grid">
      <div class="article-main">
        <ArticleBody>
          {product && <Verdict product={product} postSlug={post.slug} />}
          <Content />
          {product && <ProductCallout product={product} postSlug={post.slug} />}
          {product && <ProsConsList pros={product.pros} cons={product.cons} />}
          {hasAffiliateLinks && <AffiliateDisclosure />}
        </ArticleBody>
        <Sources
          sources={post.data.sources}
          highStakes={highStakes}
          reviewedLabel={review.inferred ? 'Last updated' : 'Last reviewed'}
          reviewedOn={formatLong(review.date)}
          nextCheck={nextCheck}
        />
      </div>

      <aside class="article-aside">
        {/* On phones and tablets the rail reflows above the prose, where a
            screenful of metadata otherwise sits between the headline and the
            first paragraph. It collapses into one row there, and the stylesheet
            below holds it open on the desktop layout. */}
        <details class="aside-details">
          <summary>
            <span class="summary-label">On this page &amp; evidence</span>
            <span class="summary-meta">{asideSummary}</span>
            <svg class="chevron" viewBox="0 0 24 24" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <div class="aside-inner">
            <TableOfContents headings={headings} />
            <EvidenceRail
              sources={post.data.sources}
              pubDate={post.data.pubDate}
              updatedDate={post.data.updatedDate}
              lastReviewed={post.data.lastReviewed}
              category={post.data.category}
            />
          </div>
        </details>
        <AdUnit placement="sidebar" />
      </aside>
    </div>

    <AuthorCard author={author} />
    <RelatedPosts posts={related} />
  </article>
</BaseLayout>

<style>
  .article-head {
    padding: 24px 0 48px;
    border-bottom: 1px solid var(--hairline);
  }
  .badges {
    display: flex;
    gap: 8px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }
  .article-head h1 {
    font-family: var(--font-display);
    font-size: clamp(40px, 5.2vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-weight: 500;
    color: var(--ink);
    max-width: none;
    margin: 0 0 24px;
    text-wrap: balance;
  }
  .article-head h1 :global(em) { font-style: italic; }
  .article-head .lede {
    font-size: 22px;
    line-height: 1.45;
    color: var(--muted);
    max-width: 60ch;
    font-weight: 400;
  }
  .article-meta {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 32px;
    flex-wrap: wrap;
  }
  .article-meta .avatar {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 15px;
    text-decoration: none;
  }
  .article-meta .author {
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
  }
  .article-meta .author:hover { color: var(--accent); }
  .article-meta .author-role { font-size: 12px; color: var(--muted); }
  .article-meta .dot {
    width: 3px;
    height: 3px;
    background: var(--muted-2);
    border-radius: 999px;
  }
  .article-meta .stat {
    font-size: 13px;
    color: var(--muted);
    display: flex;
    gap: 6px;
    align-items: center;
  }
  .article-meta .stat svg {
    width: 14px;
    height: 14px;
    stroke: var(--muted);
    stroke-width: 1.7;
    fill: none;
  }
  .article-meta .actions {
    margin-left: auto;
    display: flex;
    gap: 8px;
  }
  @media (max-width: 700px) { .article-meta .actions { margin-left: 0; } }

  .hero-image {
    aspect-ratio: 16 / 9;
    border-radius: 24px;
    overflow: hidden;
    margin: 40px 0 0;
    position: relative;
  }
  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .hero-image.is-zoomable {
    cursor: zoom-in;
  }
  .hero-image.is-zoomable:hover img {
    transform: scale(1.02);
  }
  .hero-image.is-zoomable:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .article-grid {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 64px;
    padding: 64px 0 0;
    align-items: start;
  }
  /* A grid item's automatic minimum size is its min-content width, and a
     comparison table's min-content is every column at its narrowest - wider
     than the track. Without this the 1fr track grew to fit the table, pushed
     the rail off the page and took the whole document sideways with it. The
     table scrolls inside itself instead. */
  .article-main { min-width: 0; }
  @media (max-width: 1000px) {
    .article-grid { grid-template-columns: 1fr; gap: 40px; }
    /* The rail stops being a column here. Its contents become rows of the
       article grid so the collapsed evidence row can sit under the trust
       stack, where a reader is still deciding whether to trust the piece -
       rather than a screenful of metadata before the first paragraph, or a
       jump list stranded under the article. */
    .article-aside { display: contents; }
    .aside-details { order: -1; }
  }

  /* The jump list and the evidence summary, behind one row on a phone, and a
     permanently open sidebar from 1001px up. The element ships closed in the
     HTML and the wide layout opens it in CSS, so the desktop rail is complete
     at first paint - no script, and nothing appears late enough to push the
     ad slot beneath it down the page. */
  .aside-details { border-bottom: 1px solid var(--hairline); }
  .aside-details > summary {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 10px 0;
    cursor: pointer;
    list-style: none;
    font-size: 13px;
    color: var(--ink-2);
  }
  .aside-details > summary::-webkit-details-marker { display: none; }
  .aside-details .summary-label { font-weight: 700; }
  .aside-details .summary-meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  .aside-details .chevron {
    width: 16px;
    height: 16px;
    margin-left: auto;
    stroke: var(--muted);
    stroke-width: 1.8;
    fill: none;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .aside-details[open] .chevron { transform: rotate(180deg); }
  @media (prefers-reduced-motion: reduce) {
    .aside-details .chevron { transition: none; }
  }
  @media (min-width: 1001px) {
    /* `::details-content` is the only handle CSS has on a closed disclosure:
       the content is hidden in layout, not by a rule on the child, so setting
       `display` on `.aside-inner` does nothing in any engine. Behind an
       `@supports` gate, because an engine without the pseudo-element would
       otherwise be left with the summary hidden and the content unreachable -
       there it keeps the toggle and the reader opens the rail themselves. */
    @supports selector(::details-content) {
      .aside-details::details-content { content-visibility: visible; }
      .aside-details > summary { display: none; }
      .aside-details { border-bottom: 0; }
    }
    .aside-details[open] > summary { display: none; }
    .aside-details[open] { border-bottom: 0; }
  }

  .article-aside {
    position: sticky;
    top: 100px;
    /* Bounded to the viewport and scrollable within it. A sticky rail taller
       than the screen moves with the scroll, so its lower half is unreachable —
       which for the ad slot beneath the contents means an impression that can
       never be viewed, and for a long table of contents meant entries nobody
       could reach. */
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    overscroll-behavior: contain;
    /* The rail is a scroll container now, so leave room for its scrollbar
       rather than letting one crop the unit's right edge. */
    scrollbar-gutter: stable;
  }
</style>
