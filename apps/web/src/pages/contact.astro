---
import BaseLayout from '@layouts/BaseLayout.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import Button from '@components/ui/Button.astro';
import { buildCategorySchema, buildMeta } from '@lib/seo';

const meta = buildMeta({
  title: 'Contact SleekDrops',
  description:
    "Tip about a deal? Pitch for a review? Spotted an error? The SleekDrops desk reads everything and tries to reply within two working days.",
  pathname: '/contact',
});
---
<BaseLayout
  {...meta}
  schema={buildCategorySchema('Contact', '/contact', meta.description)}
  active="contact"
>
  <section class="contact-hero">
    <div class="container">
      <Eyebrow>Get in touch</Eyebrow>
      <h1>Say <em>hello</em>.</h1>
      <p>Tip about a deal? Pitch for a review? Spotted an error? We read everything. We try to reply within two working days.</p>
    </div>
  </section>

  <div class="container">
    <div class="contact-layout">
      {/* No form here on purpose: there is no endpoint behind this page yet, and a
          form that accepts a message and answers "✓ Message sent" while nothing is
          sent is a false claim rather than an unfinished feature (see the
          conventions in AGENTS.md). Email is the honest route until the real one
          exists, and the addresses beside this card are read by people. */}
      <div class="contact-form">
        <h3>Email is <em>the way</em>, for now.</h3>
        <p>We haven't wired up a form yet, and we'd rather say so than take a message we can't deliver. Write to the desk instead: it reaches the same people.</p>
        <Button href="mailto:desk@sleekdrops.com" variant="primary" arrow>Email the desk</Button>
      </div>

      <aside class="contact-aside">
        <h3>Other <em>ways</em>.</h3>
        <div class="contact-card">
          <h6>Tip a deal</h6>
          <div class="what">deals@sleekdrops.com</div>
          <p class="note">Spotted something worth a feature? Include the link, the catch, and how long it lasts.</p>
        </div>
        <div class="contact-card">
          <h6>Pitch a review</h6>
          <div class="what">pitch@sleekdrops.com</div>
          <p class="note">Brands and PR welcome — we'll always disclose loaner units in the published review.</p>
        </div>
        <div class="contact-card">
          <h6>Editorial</h6>
          <div class="what">desk@sleekdrops.com</div>
          <p class="note">Corrections, comments, questions about our methodology, or anything else.</p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-hero { padding: 64px 0 32px; }
  .contact-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(56px, 8vw, 96px);
    line-height: 0.95;
    letter-spacing: -0.03em;
    font-weight: 400;
    color: var(--ink);
    margin: 16px 0;
  }
  .contact-hero h1 em { font-style: italic; }
  .contact-hero p {
    font-size: 19px;
    color: var(--muted);
    max-width: 56ch;
    margin: 0;
    line-height: 1.55;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 64px;
    padding: 48px 0 96px;
    align-items: start;
  }
  @media (max-width: 900px) { .contact-layout { grid-template-columns: 1fr; } }

  .contact-form {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 24px;
    padding: 40px;
  }
  .contact-form h3 {
    font-family: var(--font-display);
    font-size: 32px;
    line-height: 1.2;
    letter-spacing: -0.015em;
    font-weight: 400;
    color: var(--ink);
    margin: 0 0 16px;
  }
  .contact-form h3 em { font-style: italic; }
  .contact-form p {
    font-size: 16px;
    color: var(--muted);
    line-height: 1.6;
    margin: 0 0 28px;
    max-width: 46ch;
  }

  .contact-aside h3 {
    font-family: var(--font-display);
    font-size: 32px;
    letter-spacing: -0.015em;
    font-weight: 400;
    color: var(--ink);
    margin: 0 0 24px;
  }
  .contact-aside h3 em { font-style: italic; }
  .contact-card {
    padding: 24px 0;
    border-top: 1px solid var(--hairline);
  }
  .contact-card:last-child { border-bottom: 1px solid var(--hairline); }
  .contact-card h6 {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--accent);
    margin: 0 0 8px;
  }
  .contact-card .what {
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0 0 4px;
  }
  .contact-card .note {
    font-size: 13px;
    color: var(--muted);
    margin: 8px 0 0;
    line-height: 1.5;
  }
</style>
