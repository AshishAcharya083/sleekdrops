---
import JsonLd from './JsonLd.astro';
import type { Thing, WithContext } from 'schema-dts';
import type { MetaPayload } from '@lib/seo';
import { adsEnv } from '@lib/ads-env';

/**
 * SEOHead — every meta tag we ship on every page. Pass the MetaPayload
 * from buildMeta() plus an optional structured-data `schema`.
 *
 * `schema` takes one object or several: an article page ships Article plus
 * FAQPage, and separate <script> blocks are what Google's own docs recommend
 * over cramming unrelated types into one @graph. Nulls are dropped, so a
 * builder that declines to emit (buildFaqSchema on a post with no FAQ) can be
 * passed straight through.
 *
 * Also bootstraps dark mode before paint so the theme never flashes.
 */
export interface Props extends MetaPayload {
  schema?: WithContext<Thing> | Array<WithContext<Thing> | null | undefined> | null;
}

/**
 * AdSense site verification, and the one piece of the ad integration that is
 * deliberately *not* behind the consent gate.
 *
 * It has to be ungated to work at all: `src/lib/ads.ts` requests the partner
 * script only for a visitor who switched Advertising on, and neither AdSense's
 * site-verification crawler nor its policy reviewer accepts a consent banner —
 * so on a consent-gated site the script is never what they find, and the site
 * is never approved. Google publishes this tag for exactly that case.
 *
 * Ungating it costs the visitor nothing, which is why it is allowed to be the
 * exception: it is an inert `<meta>` element carrying an account id that already
 * ships publicly in `/ads.txt`. It loads no script, sets no cookie, writes no
 * device storage and makes no request, so ePrivacy Art. 5(3) — the rule the
 * consent gate exists to satisfy — does not reach it.
 *
 * Empty when the build has no publisher id, so an unconfigured build (develop,
 * and every local `pnpm dev`) still claims nothing.
 */
const { client: adsenseAccount } = adsEnv();

const {
  title,
  description,
  canonicalUrl,
  image,
  type,
  noindex,
  prevUrl,
  nextUrl,
  schema,
} = Astro.props;

// Normalized here rather than in the template: the markup body is plain JS,
// so the type predicate that narrows away the nulls cannot live there.
const schemas = (Array.isArray(schema) ? schema : [schema]).filter(
  (entry): entry is WithContext<Thing> => Boolean(entry),
);
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<meta name="commission-factory-verification" content="68622d36d11b400e94e31681bc8224a8" />
{adsenseAccount && <meta name="google-adsense-account" content={adsenseAccount} />}

<title>{title} | SleekDrops</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content="SleekDrops" />
<meta property="og:title" content={`${title} | SleekDrops`} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={`${title} | SleekDrops`} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

<link rel="alternate" type="application/rss+xml" title="SleekDrops RSS Feed" href="/rss.xml" />
{prevUrl && <link rel="prev" href={prevUrl} />}
{nextUrl && <link rel="next" href={nextUrl} />}
{schemas.map((entry) => <JsonLd schema={entry} />)}

<script is:inline>
  (function () {
    try {
      var t = localStorage.getItem('sd-theme');
      if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
    } catch (_) {}
  })();
</script>
