---
import { adsEnv } from '@lib/ads-env';
import { GOOGLE_EU_CONSENT_REGIONS } from '@lib/google-consent';

/**
 * Production AdSense bootstrap.
 *
 * Loading Google's publisher tag is what lets the certified Google CMP display
 * the European regulations message configured in AdSense. The privacy-policy
 * route opts out in BaseLayout because Google requires the policy page itself
 * to be free of the ad tag / Funding Choices message.
 */
const { client } = adsEnv();
const consentRegions = [...GOOGLE_EU_CONSENT_REGIONS];
const src = client
  ? `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${encodeURIComponent(client)}`
  : '';
---

{client && (
  <>
    <script is:inline define:vars={{ consentRegions }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };

      // Google's CMP is only shown in the EEA, UK and Switzerland. Keep
      // analytics opt-in everywhere, while allowing the ad defaults Google
      // applies outside those regions to remain unrestricted by a banner the
      // visitor will never be shown.
      window.gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'granted',
        ad_user_data: 'granted',
        ad_personalization: 'granted'
      });

      // A region-specific default is more specific than the worldwide command
      // above and therefore wins for these visitors. Google's CMP updates these
      // three signals after the visitor chooses Consent, Do not consent, or
      // Manage options.
      window.gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        region: consentRegions,
        wait_for_update: 500
      });
    </script>
    <script is:inline async crossorigin="anonymous" src={src}></script>
  </>
)}
