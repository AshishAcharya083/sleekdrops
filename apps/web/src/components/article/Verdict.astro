---
import Button from '@components/ui/Button.astro';
import StarRating from '@components/affiliate/StarRating.astro';
import { EVENTS } from '@lib/analytics';
import type { ProductData } from '../../content/config';

/**
 * Verdict — the "Quick Verdict" box that opens every review. Pairs the
 * product tagline with a numeric score, star row, and primary affiliate
 * CTA. Required by the review-quality rules in sleekdrops-cms/schema/.
 *
 * The affiliate href is built from the post slug: every review post's
 * filename must match a key in sleekdrops-cms/data/affiliate-links.json.
 */
export interface Props {
  product: ProductData;
  postSlug: string;
}
const { product, postSlug } = Astro.props;
const href = `/go/${postSlug}`;
---
<aside class="verdict">
  <div>
    <h3>Quick verdict</h3>
    <p class="title">{product.tagline}</p>
    <p class="desc">{product.brand} {product.name} — full breakdown below.</p>
    <Button
      href={href}
      variant="accent"
      arrow
      rel="sponsored nofollow"
      data={{ track: EVENTS.affiliateClick, 'track-props': JSON.stringify({ slug: postSlug, brand: product.brand, placement: 'verdict' }) }}
    >
      See current price
    </Button>
  </div>
  <div class="score">
    <div class="score-num">{product.rating.toFixed(1)}<sup>&nbsp;/5</sup></div>
    <StarRating rating={product.rating} />
  </div>
</aside>

<style>
  .verdict {
    background: var(--surface);
    border: 1px solid var(--hairline-strong);
    border-radius: 20px;
    padding: 28px 32px;
    margin: 32px 0;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 28px;
    align-items: center;
  }
  h3 {
    margin: 0;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--accent);
  }
  .title {
    font-family: var(--font-display);
    font-size: 28px;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 8px 0 12px;
    font-weight: 400;
  }
  .desc {
    font-size: 14px;
    color: var(--muted);
    margin: 0 0 16px;
    max-width: 50ch;
  }
  .score { text-align: right; }
  .score-num {
    font-family: var(--font-display);
    font-size: 64px;
    line-height: 1;
    color: var(--ink);
    letter-spacing: -0.03em;
  }
  .score-num sup {
    font-size: 22px;
    color: var(--muted);
    font-style: italic;
  }

  @media (max-width: 700px) {
    .verdict { grid-template-columns: 1fr; }
    .score { text-align: left; }
  }
</style>
