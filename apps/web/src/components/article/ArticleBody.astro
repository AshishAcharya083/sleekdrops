---
/**
 * ArticleBody — the editorial body wrapper. Wrap the rendered markdown
 * <Content /> with this; it owns the prose typography, drop-cap, and
 * inline-link treatments.
 *
 * It also ends with the read-completion sentinel: crossing it is one half of
 * the gate that emits `Article Read` (see src/lib/read-completion.ts). The
 * sentinel lives here rather than on the page so it is always the last thing in
 * the body, whatever the page appends after the markdown.
 *
 * It carries the two in-article ad slots for the same reason: the body is the
 * only thing that knows where the content actually ends, and the mid-article
 * unit has to be positioned against the rendered blocks rather than against the
 * page's source. `<slot />` is markdown plus whatever the page appends, so the
 * mid unit is placed here on the client, where those blocks exist as elements —
 * the rule for *which* block it goes before is the pure `midArticleIndex` in
 * src/lib/ad-placement.ts, and a body too short to carry one loses it entirely.
 *
 * Both units render nothing at all unless the build has ids for them and the
 * visitor opted in to advertising; see src/components/ads/AdUnit.astro.
 */
import AdUnit from '@components/ads/AdUnit.astro';
---
<div class="article-body" data-article-body>
  <slot />
  <AdUnit placement="articleMid" />
  <AdUnit placement="articleEnd" />
  <div class="read-sentinel" data-read-sentinel aria-hidden="true" />
</div>

<style>
  .article-body {
    max-width: 68ch;
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.75;
    color: var(--ink-2);
    min-width: 0;
  }
  .article-body :global(> * + *) { margin-top: 1.3em; }
  /* Zero-height and unspaced: the sentinel marks the end of the body, it does
     not add one. More specific than the sibling rule above, so it wins. */
  .article-body :global(> .read-sentinel) { margin-top: 0; height: 0; }
  .article-body :global(p) { margin: 0; }
  .article-body :global(> p:first-of-type::first-letter) {
    font-family: var(--font-display);
    font-size: 88px;
    line-height: 0.85;
    float: left;
    margin: 8px 12px 0 0;
    color: var(--ink);
    font-weight: 400;
  }
  .article-body :global(h2) {
    font-family: var(--font-display);
    font-size: 40px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 400;
    color: var(--ink);
    margin: 2.2em 0 0.4em;
    scroll-margin-top: 100px;
  }
  .article-body :global(h2 em) { font-style: italic; }
  .article-body :global(h3) {
    font-family: var(--font-body);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 1.8em 0 0.4em;
    scroll-margin-top: 100px;
  }
  .article-body :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
  }
  .article-body :global(a:hover) { color: var(--accent); }
  .article-body :global(em) {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05em;
  }
  .article-body :global(strong) { color: var(--ink); font-weight: 700; }
  .article-body :global(ul),
  .article-body :global(ol) { padding-left: 1.25em; }
  .article-body :global(li) { margin: 0.5em 0; }
  .article-body :global(img) {
    width: 100%;
    border-radius: 16px;
    margin: 1.5em 0;
  }
  .article-body :global(blockquote) {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 30px;
    line-height: 1.3;
    color: var(--ink);
    border-left: 2px solid var(--accent);
    padding: 4px 0 4px 28px;
    margin: 2em 0;
    max-width: 38ch;
    letter-spacing: -0.005em;
  }

  /* GFM tables — pipe-table syntax in markdown. */
  .article-body :global(.table-wrap) {
    margin: 2em 0;
    overflow-x: auto;
    border: 1px solid var(--hairline);
    border-radius: 12px;
  }
  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
    line-height: 1.5;
  }
  .article-body :global(thead) {
    background: var(--paper-2, #f6f5f1);
  }
  .article-body :global(th),
  .article-body :global(td) {
    padding: 12px 16px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--hairline);
  }
  .article-body :global(th) {
    font-family: var(--font-body);
    font-weight: 700;
    color: var(--ink);
    font-size: 13px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .article-body :global(tbody tr:last-child td) { border-bottom: 0; }
  .article-body :global(tbody tr:hover) {
    background: color-mix(in srgb, var(--accent) 4%, transparent);
  }

  /* GFM strikethrough + task lists. */
  .article-body :global(del) {
    color: var(--muted);
    text-decoration-thickness: 1.5px;
  }
  .article-body :global(li.task-list-item) {
    list-style: none;
    margin-left: -1.25em;
    padding-left: 0;
  }
  .article-body :global(li.task-list-item input[type='checkbox']) {
    margin-right: 8px;
    accent-color: var(--accent);
  }

  /* Inline + fenced code blocks (Shiki handles syntax colors). */
  .article-body :global(code) {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.92em;
    background: var(--paper-2, #f6f5f1);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }
  .article-body :global(pre) {
    margin: 1.5em 0;
    padding: 18px 20px;
    border-radius: 12px;
    border: 1px solid var(--hairline);
    overflow-x: auto;
    font-size: 14px;
    line-height: 1.55;
  }
  .article-body :global(pre code) {
    background: transparent;
    padding: 0;
  }

  /* Horizontal rule (---). */
  .article-body :global(hr) {
    border: 0;
    border-top: 1px solid var(--hairline);
    margin: 2.5em 0;
  }

  /* The ad slots set their own rhythm, wider than the prose sibling rule's.
     The attribute is carried purely to out-specify that rule (both are two
     classes, so source order would otherwise decide it). */
  .article-body :global(> .ad-unit[data-ad-unit]) { margin: 2.5em 0; }
</style>

<script>
  import { midArticleIndex } from '@lib/ad-placement';

  /**
   * Move the mid-article unit to the break it belongs on, or drop it if this
   * body is too short to carry one.
   *
   * Done here rather than in the page source because `<slot />` is rendered
   * markdown: the blocks the unit is positioned against only exist as elements
   * once the document does. The unit ships at the end of the body and moves up,
   * which is also why the order this runs in relative to AdUnit's own script does
   * not matter - an IntersectionObserver watches the *element*, so a node moved
   * before the callback fires is observed wherever it lands, and a node already
   * removed for a visitor who declined is simply not found here.
   */
  const body = document.querySelector<HTMLElement>('[data-article-body]');
  const unit = body?.querySelector<HTMLElement>('[data-ad-placement="articleMid"]');

  if (body && unit) {
    // The editorial blocks only: not the two ad slots, not the read sentinel.
    const blocks = Array.from(body.children).filter(
      (el) => !el.hasAttribute('data-ad-unit') && !el.hasAttribute('data-read-sentinel'),
    );
    const index = midArticleIndex(blocks.map((el) => el.tagName.toLowerCase()));
    if (index === null) unit.remove();
    else body.insertBefore(unit, blocks[index]);
  }
</script>
