---
/**
 * ArticleBody — the editorial body wrapper. Wrap the rendered markdown
 * <Content /> with this; it owns the prose typography, drop-cap, and
 * inline-link treatments.
 *
 * It also ends with the read-completion sentinel: crossing it is one half of
 * the gate that emits `Article Read` (see src/lib/read-completion.ts). The
 * sentinel lives here rather than on the page so it is always the last thing in
 * the body, whatever the page appends after the markdown.
 *
 * It is also the ad partner's `journey-content` landmark: Mediavine's wrapper
 * (see src/components/ads/MediavineScript.astro) looks for that class on the
 * element whose *immediate* children are the article's paragraphs, headings and
 * figures, and places its in-content units between them itself - which is why
 * the class sits on this wrapper and not on the page's `<main>` or `<article>`,
 * and why it must appear once per page. The site carries no ad units of its
 * own; a body too short to hold one is the partner's call, made from the
 * rendered blocks.
 */
---
<div class="article-body journey-content" data-article-body>
  <slot />
  <div class="read-sentinel" data-read-sentinel aria-hidden="true" />
</div>

<style>
  .article-body {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.75;
    color: var(--ink-2);
    min-width: 0;
  }
  /* The reading measure belongs to the prose, not to the column. Carried on
     the whole body it also bound the comparison tables, which are the widest
     thing an article renders and the one block that needs the column it has. */
  .article-body :global(> *) { max-width: var(--max-reading); }
  .article-body :global(> * + *) { margin-top: 1.3em; }
  /* Zero-height and unspaced: the sentinel marks the end of the body, it does
     not add one. More specific than the sibling rule above, so it wins. */
  .article-body :global(> .read-sentinel) { margin-top: 0; height: 0; }
  .article-body :global(p) { margin: 0; }
  .article-body :global(> p:first-of-type::first-letter) {
    font-family: var(--font-display);
    font-size: 88px;
    line-height: 0.85;
    float: left;
    margin: 8px 12px 0 0;
    color: var(--ink);
    font-weight: 400;
  }
  .article-body :global(h2) {
    font-family: var(--font-display);
    font-size: 40px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 400;
    color: var(--ink);
    margin: 2.2em 0 0.4em;
    scroll-margin-top: 100px;
  }
  .article-body :global(h2 em) { font-style: italic; }
  .article-body :global(h3) {
    font-family: var(--font-body);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 1.8em 0 0.4em;
    scroll-margin-top: 100px;
  }
  .article-body :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
  }
  .article-body :global(a:hover) { color: var(--accent); }
  .article-body :global(em) {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05em;
  }
  .article-body :global(strong) { color: var(--ink); font-weight: 700; }
  .article-body :global(ul),
  .article-body :global(ol) { padding-left: 1.25em; }
  .article-body :global(li) { margin: 0.5em 0; }
  .article-body :global(img) {
    width: 100%;
    border-radius: 16px;
    margin: 1.5em 0;
  }
  .article-body :global(blockquote) {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 30px;
    line-height: 1.3;
    color: var(--ink);
    border-left: 2px solid var(--accent);
    padding: 4px 0 4px 28px;
    margin: 2em 0;
    max-width: 38ch;
    letter-spacing: -0.005em;
  }

  /* A citation marker the pipeline's writer left in the body, turned into a
     link to the sources block by lib/rehype-citations.mjs. No underline of its
     own: the marker rides above the baseline, so a border under it detaches
     from the line it belongs to. Superscript citations are inline text links,
     exempt from the 44px target under WCAG 2.5.5. */
  .article-body :global(sup.citation) {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 0;
    vertical-align: super;
    white-space: nowrap;
  }
  .article-body :global(sup.citation a) {
    color: var(--muted);
    text-decoration: none;
    padding: 1px 2px;
    border-radius: 3px;
  }
  .article-body :global(sup.citation a:hover) {
    color: var(--accent);
    background: var(--accent-soft);
  }

  /* GFM tables — pipe-table syntax in markdown. */
  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
    line-height: 1.5;
  }
  /* A comparison table is the one block allowed the article column's full
     width rather than the prose measure: seven columns squeezed into 68ch is
     what clipped the scorecard. Wider than the column it scrolls inside
     itself, so a wide table never pushes the page sideways. */
  .article-body :global(> table) {
    display: block;
    width: max-content;
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid var(--hairline);
    border-radius: 12px;
  }
  /* Raised by the script below only on a table that is genuinely clipped, so a
     table that fits its column never carries a hint. Sits above the table: the
     point of it is to be read before the reader decides the table is cut off. */
  .article-body :global(> .table-scroll-hint) {
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  /* `display` here beats the `hidden` attribute's UA `display: none`, so the
     hidden state has to be restated. */
  .article-body :global(> .table-scroll-hint[hidden]) { display: none; }
  .article-body :global(> .table-scroll-hint::after) {
    content: '→';
    font-size: 14px;
  }
  /* The hint belongs to the table under it, not to the prose above it. Only
     while it is shown: a hidden hint must leave the block rhythm untouched. */
  .article-body :global(> .table-scroll-hint:not([hidden]) + table) { margin-top: 8px; }
  .article-body :global(> table[tabindex]:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .article-body :global(thead) {
    background: var(--paper-2, #f6f5f1);
  }
  .article-body :global(th),
  .article-body :global(td) {
    padding: 12px 16px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--hairline);
  }
  .article-body :global(th) {
    font-family: var(--font-body);
    font-weight: 700;
    color: var(--ink);
    font-size: 13px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  /* `th` as well as `td`: a table with a row header in the first column keeps
     a hairline under its last row otherwise, which reads as a missing row. */
  .article-body :global(tbody tr:last-child td),
  .article-body :global(tbody tr:last-child th) { border-bottom: 0; }
  .article-body :global(tbody tr:hover) {
    background: color-mix(in srgb, var(--accent) 4%, transparent);
  }

  /* GFM strikethrough + task lists. */
  .article-body :global(del) {
    color: var(--muted);
    text-decoration-thickness: 1.5px;
  }
  .article-body :global(li.task-list-item) {
    list-style: none;
    margin-left: -1.25em;
    padding-left: 0;
  }
  .article-body :global(li.task-list-item input[type='checkbox']) {
    margin-right: 8px;
    accent-color: var(--accent);
  }

  /* Inline + fenced code blocks (Shiki handles syntax colors). */
  .article-body :global(code) {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.92em;
    background: var(--paper-2, #f6f5f1);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }
  .article-body :global(pre) {
    margin: 1.5em 0;
    padding: 18px 20px;
    border-radius: 12px;
    border: 1px solid var(--hairline);
    overflow-x: auto;
    font-size: 14px;
    line-height: 1.55;
  }
  .article-body :global(pre code) {
    background: transparent;
    padding: 0;
  }

  /* Horizontal rule (---). */
  .article-body :global(hr) {
    border: 0;
    border-top: 1px solid var(--hairline);
    margin: 2.5em 0;
  }

</style>

<script>
  import { TABLE_SCROLL_HINT, overflowsSideways } from '@lib/table-scroll';

  const body = document.querySelector<HTMLElement>('[data-article-body]');

  /**
   * Tell the reader a wide table can be swiped, on the tables where that is
   * true.
   *
   * A table wider than the article column scrolls inside itself, which is right
   * and invisible: on a phone a seven-column scorecard is simply clipped
   * mid-column. The hint is raised against the table's measured overflow rather
   * than a breakpoint - the width at which a table overflows is a property of
   * that table - so it appears exactly where there is something to scroll to
   * and disappears when the window grows past it. The same condition makes the
   * box focusable, since a scroll container a mouse can drag is otherwise
   * unreachable by keyboard.
   */
  if (body) {
    const tables = Array.from(body.querySelectorAll<HTMLTableElement>(':scope > table'));

    const hintFor = (table: HTMLElement): HTMLElement => {
      const previous = table.previousElementSibling;
      if (previous instanceof HTMLElement && previous.dataset.tableHint !== undefined) {
        return previous;
      }
      // A div, not a p: the body's drop-cap rule keys off `> p:first-of-type`,
      // and an article that opens on a table would hand it to this hint.
      const hint = document.createElement('div');
      hint.className = 'table-scroll-hint';
      hint.dataset.tableHint = '';
      hint.textContent = TABLE_SCROLL_HINT;
      table.before(hint);
      return hint;
    };

    const sync = () => {
      for (const table of tables) {
        const scrolls = overflowsSideways(table.scrollWidth, table.clientWidth);
        hintFor(table).hidden = !scrolls;
        if (scrolls) table.setAttribute('tabindex', '0');
        else table.removeAttribute('tabindex');
      }
    };

    if (tables.length > 0) {
      sync();
      // The column width the table is measured against changes with the window,
      // and the table's own width changes when the editorial webfonts land.
      if (typeof ResizeObserver === 'function') {
        const observer = new ResizeObserver(sync);
        for (const table of tables) observer.observe(table);
      } else {
        window.addEventListener('resize', sync);
      }
      document.fonts?.ready.then(sync);
    }
  }
</script>
