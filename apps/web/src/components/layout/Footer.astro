---
import BrandMark from '@components/ui/BrandMark.astro';
import { categories } from '@data/categories';
import { getActiveDeals } from '@data/deals';
import { getPostsByType } from '@lib/posts';

const [reviews, guides] = await Promise.all([
  getPostsByType('review'),
  getPostsByType('guide'),
]);
const exploreLinks = [
  { label: 'All posts', href: '/blog' },
  ...(reviews.length > 0 ? [{ label: 'Reviews', href: '/reviews' }] : []),
  ...(guides.length > 0 ? [{ label: 'Buying guides', href: '/guides' }] : []),
  ...(getActiveDeals().length > 0 ? [{ label: "Today's deals", href: '/deals' }] : []),
];
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <BrandMark />
        <p>Independent product research, side-by-side comparisons and practical buying guides for Australian shoppers.</p>
      </div>

      <div class="footer-col">
        <h6>Explore</h6>
        <ul>
          {exploreLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>

      <div class="footer-col">
        <h6>Categories</h6>
        <ul>
          {categories.map((c) => (
            <li><a href={`/category/${c.slug}`}>{c.name}</a></li>
          ))}
        </ul>
      </div>

    </div>

    <div class="footer-bottom">
      <span>© {year} SleekDrops. All editorial coverage is independent.</span>
      <span class="footer-links">
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a href="/privacy">Privacy</a>
        <a href="/disclaimer">Disclaimer</a>
        {/* The dialog this reopens is client-side only, so the control ships
            hidden and the island script below reveals it - a visitor without
            JavaScript is shown no control rather than a dead one. It is the
            footer entry the preferences dialog and the privacy policy both
            promise. */}
        <button type="button" aria-haspopup="dialog" data-consent-preferences hidden>Privacy preferences</button>
      </span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--hairline);
    padding: 64px 0 48px;
    margin-top: 96px;
    background: var(--paper);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 48px;
  }
  .footer-col :global(.brand) { margin-bottom: 16px; }
  .footer-col h6 {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--muted);
    margin: 0 0 16px;
  }
  .footer-col ul { list-style: none; padding: 0; margin: 0; }
  .footer-col li { margin-bottom: 10px; }
  .footer-col a {
    font-size: 14px;
    color: var(--ink);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .footer-col a:hover { color: var(--accent); }
  .footer-col p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0 0 14px;
  }
  .footer-bottom {
    padding-top: 32px;
    border-top: 1px solid var(--hairline);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    color: var(--muted);
    gap: 16px;
    flex-wrap: wrap;
  }
  .footer-links { display: flex; gap: 18px; flex-wrap: wrap; align-items: center; }
  .footer-links a { color: var(--muted); text-decoration: none; }
  .footer-links a:hover { color: var(--accent); }
  /* Reads as one of the links beside it - it is the same kind of destination,
     it just opens a dialog instead of a page. */
  .footer-links button {
    font: inherit;
    line-height: inherit;
    color: var(--muted);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .footer-links button:hover { color: var(--accent); }
  .footer-links button[hidden] { display: none; }

  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: 1fr; gap: 32px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-links button { transition: none; }
  }
</style>

<script>
  import { openConsentPreferences } from '@lib/consent-preferences';

  document.querySelectorAll<HTMLButtonElement>('[data-consent-preferences]').forEach((button) => {
    button.hidden = false;
    button.addEventListener('click', () => {
      // Safari does not focus a button on click, and the dialog hands focus back
      // to whatever was focused when it opened - so say it explicitly rather than
      // leave the visitor's focus on <body> when they close it again.
      button.focus();
      openConsentPreferences(document);
    });
  });
</script>
