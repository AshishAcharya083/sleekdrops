---
import Eyebrow from '@components/ui/Eyebrow.astro';

/**
 * Newsletter sign-up band. Shown near the page foot on the home, blog
 * listing, and about pages. Tone (per the design system) is calm and
 * declarative — no urgency hype.
 *
 * There is no mailing list behind this yet: no ESP, no subscribers table, no
 * endpoint. The band therefore carries no email field and no submit control -
 * an input that accepts an address and answers "✓ Subscribed" tells the visitor
 * something untrue, and leaving the input while captioning it "coming soon"
 * only means people type into it anyway. The layout is otherwise untouched so
 * the real capture drops straight back into it.
 */
export interface Props {
  eyebrow?: string;
  headline?: string;
  desc?: string;
}
const {
  eyebrow = 'The Daily Drop',
  headline = 'One <em>honest</em> deal, every morning.',
  desc = 'No "exclusive offers." No "limited time only." Just one product we\'d actually buy, with the real price and the real catch.',
} = Astro.props;
---
<section class="newsletter-band">
  <div class="container container--narrow">
    <Eyebrow accent>{eyebrow}</Eyebrow>
    <h2 set:html={headline} />
    <p>{desc}</p>
    <div class="newsletter-pending">
      <button type="button" disabled>Coming soon</button>
    </div>
    <div class="newsletter-meta">Drop alerts are coming soon. There is no list to join yet.</div>
  </div>
</section>

<style>
  .newsletter-band {
    padding: 80px 0;
    background: var(--surface-2);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    text-align: center;
  }
  h2 {
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1;
    letter-spacing: -0.025em;
    font-weight: 400;
    color: var(--ink);
    margin: 8px auto 16px;
    max-width: 18ch;
  }
  h2 :global(em) { font-style: italic; }
  p {
    font-size: 17px;
    color: var(--muted);
    max-width: 50ch;
    margin: 0 auto 32px;
  }
  .newsletter-pending {
    display: flex;
    justify-content: center;
  }
  .newsletter-pending button {
    background: var(--ink);
    color: var(--paper);
    border: 0;
    padding: 12px 24px;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    opacity: 0.45;
    cursor: not-allowed;
  }
  .newsletter-meta {
    font-size: 12px;
    color: var(--muted);
    margin-top: 16px;
    letter-spacing: 0.04em;
  }
</style>
