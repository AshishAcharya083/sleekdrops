---
import { authorInitials, type Author } from '@data/authors';

/**
 * AuthorCard — taller block shown at the end of an article. Includes the
 * full bio and a link to the author archive page.
 */
export interface Props { author: Author; }
const { author } = Astro.props;
---
<aside class="author-card">
  <div class="avatar" aria-hidden="true">{authorInitials(author)}</div>
  <div>
    <div class="role">{author.role}</div>
    <h4>{author.name}</h4>
    <p>{author.bio}</p>
    <a href={`/author/${author.id}`}>All posts by {author.name.split(' ')[0]} →</a>
  </div>
</aside>

<style>
  .author-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 20px;
    padding: 28px;
    border: 1px solid var(--hairline);
    border-radius: 16px;
    background: var(--surface);
    margin-top: 48px;
  }
  .avatar {
    width: 56px;
    height: 56px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 20px;
  }
  .role {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--accent);
  }
  h4 {
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 4px 0 8px;
    font-weight: 400;
  }
  p {
    font-size: 14px;
    color: var(--muted);
    margin: 0 0 12px;
  }
  a {
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
    border-bottom: 1.5px solid var(--accent);
    padding-bottom: 2px;
  }
  a:hover { color: var(--accent); }
</style>
