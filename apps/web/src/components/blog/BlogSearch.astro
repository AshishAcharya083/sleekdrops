---
/**
 * BlogSearch — the search entry point advertised by the header button and the
 * homepage SearchAction (target `/blog?query=`).
 *
 * A native GET form (so it degrades to a plain reload without JS) plus a
 * client-rendered results region. With no `?query=` the blog's normal paginated
 * grid (`[data-search-default]`) shows; with a query the grid is hidden and
 * matches from the static /search-index.json render here — or a graceful empty /
 * error state, so a failed lookup never throws into analytics.
 */
---
<form class="blog-search" role="search" method="get" action="/blog" data-blog-search>
  <label class="blog-search__label" for="blog-search-input">Search the blog</label>
  <div class="blog-search__field">
    <svg class="blog-search__icon" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="11" cy="11" r="7" />
      <line x1="21" y1="21" x2="16.65" y2="16.65" />
    </svg>
    <input
      id="blog-search-input"
      class="blog-search__input"
      type="search"
      name="query"
      placeholder="Search reviews, guides, and comparisons…"
      autocomplete="off"
      enterkeyhint="search"
      data-search-input
    />
  </div>
</form>
<section class="sd-search-results" data-search-results hidden aria-live="polite"></section>

<style>
  .blog-search {
    padding: 32px 0 8px;
  }
  .blog-search__label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--muted);
    margin-bottom: 10px;
  }
  .blog-search__field {
    position: relative;
    display: flex;
    align-items: center;
  }
  .blog-search__icon {
    position: absolute;
    left: 16px;
    width: 18px;
    height: 18px;
    stroke: var(--muted);
    stroke-width: 1.7;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
  }
  .blog-search__input {
    width: 100%;
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--r-full);
    padding: 14px 20px 14px 46px;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .blog-search__input::placeholder { color: var(--muted-2); }
  .blog-search__input:hover { border-color: var(--hairline-strong); }
  .blog-search__input:focus-visible {
    outline: none;
    border-color: var(--accent);
  }
</style>

<script>
  import { searchPosts, type SearchDoc } from '@lib/search';

  const form = document.querySelector<HTMLFormElement>('[data-blog-search]');
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const results = document.querySelector<HTMLElement>('[data-search-results]');
  const defaultListing = document.querySelector<HTMLElement>('[data-search-default]');

  if (form && input && results && defaultListing) {
    let indexPromise: Promise<SearchDoc[]> | null = null;

    const loadIndex = (): Promise<SearchDoc[]> => {
      if (!indexPromise) {
        indexPromise = fetch('/search-index.json').then((res) => {
          if (!res.ok) throw new Error(`search index request failed: ${res.status}`);
          return res.json() as Promise<SearchDoc[]>;
        });
      }
      return indexPromise;
    };

    const showStatus = (message: string): void => {
      results.replaceChildren();
      const p = document.createElement('p');
      p.className = 'sd-search-status';
      p.textContent = message;
      results.appendChild(p);
    };

    const appendClearLink = (): void => {
      const clear = document.createElement('a');
      clear.className = 'sd-search-clear';
      clear.href = '/blog';
      clear.textContent = 'Clear search and browse all posts';
      results.appendChild(clear);
    };

    const render = (query: string, matches: SearchDoc[]): void => {
      results.replaceChildren();

      const summary = document.createElement('p');
      summary.className = 'sd-search-status';
      summary.textContent =
        matches.length === 0
          ? `No results for “${query}”.`
          : `${matches.length} result${matches.length === 1 ? '' : 's'} for “${query}”.`;
      results.appendChild(summary);

      if (matches.length === 0) {
        appendClearLink();
        return;
      }

      const list = document.createElement('div');
      list.className = 'sd-search-list';
      for (const doc of matches) {
        const item = document.createElement('a');
        item.className = 'sd-search-item';
        item.href = doc.url;

        const category = document.createElement('span');
        category.className = 'sd-search-item__cat';
        category.textContent = doc.category;

        const title = document.createElement('h3');
        title.className = 'sd-search-item__title';
        title.textContent = doc.title;

        const dek = document.createElement('p');
        dek.className = 'sd-search-item__dek';
        dek.textContent = doc.dek;

        item.append(category, title, dek);
        list.appendChild(item);
      }
      results.appendChild(list);
      appendClearLink();
    };

    const runSearch = async (query: string): Promise<void> => {
      defaultListing.hidden = true;
      results.hidden = false;
      showStatus('Searching…');
      try {
        const docs = await loadIndex();
        render(query, searchPosts(docs, query));
      } catch (error) {
        // Reset so a later attempt can retry, and surface a UI state rather than
        // letting the rejection reach the global error handler / analytics.
        indexPromise = null;
        console.error('[search] index unavailable', error);
        showStatus('Search is temporarily unavailable. Please try again in a moment.');
        appendClearLink();
      }
    };

    const clearSearch = (): void => {
      results.hidden = true;
      results.replaceChildren();
      defaultListing.hidden = false;
    };

    const params = new URLSearchParams(location.search);
    const initialQuery = (params.get('query') ?? '').trim();
    input.value = initialQuery;
    if (location.hash === '#search') input.focus();
    if (initialQuery) void runSearch(initialQuery);

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const query = input.value.trim();
      const nextUrl = query ? `/blog?query=${encodeURIComponent(query)}` : '/blog';
      history.replaceState(null, '', nextUrl);
      if (query) void runSearch(query);
      else clearSearch();
    });
  }
</script>
