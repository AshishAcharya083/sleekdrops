---
import { EVENTS } from '@lib/analytics';
import { cardClickProps, type ListId } from '@lib/listing';
import type { Deal } from '@data/deals';

/**
 * DealCard — small affiliate-deal tile used in the "this week's drops"
 * grid on the homepage and the deals index. Links to the deal detail
 * page, not the external retailer (so we can show the disclosure + terms
 * before the click-out).
 *
 * `listId` and `position` are required rather than optional: the click-through
 * rate of a card is only meaningful against the list it was rendered in and the
 * slot it occupied, so a card that cannot say where it sat is a card whose
 * clicks cannot be read. They carry the same `list_id` the enclosing list's
 * `Listing Viewed` event reports.
 */
export interface Props {
  deal: Deal;
  listId: ListId;
  /** Zero-based slot in the rendered list. */
  position: number;
}
const { deal, listId, position } = Astro.props;
---
<a
  class="deal-mini"
  href={`/deals/${deal.slug}`}
  data-track={EVENTS.dealCardClick}
  data-track-props={JSON.stringify(
    cardClickProps({ listId, slug: deal.slug, brand: deal.brand, placement: 'deal-card', position }),
  )}
>
  <div class="deal-mini-head">
    <div class="logo" aria-hidden="true">{deal.brandMark}</div>
    <div class="brand-row">
      <span class="brand-name">{deal.brand}</span>
      <span class="disc">{deal.discountLabel}</span>
    </div>
  </div>
  <div class="title">{deal.title}</div>
  <div class="prices">
    <span class="now">{deal.priceNow}</span>
    <span class="was">{deal.priceWas}</span>
  </div>
  <span class="ends">{deal.ends}</span>
</a>

<style>
  .deal-mini {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 16px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none;
    color: inherit;
    transition: all var(--dur-base) var(--ease-out);
  }
  .deal-mini:hover {
    border-color: var(--hairline-strong);
    box-shadow: var(--shadow-md);
    color: inherit;
  }
  .deal-mini-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .logo {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: linear-gradient(135deg, #0F0F0E, #2A2A28);
    color: var(--paper);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 18px;
    flex-shrink: 0;
  }
  .brand-row { display: flex; flex-direction: column; }
  .brand-name {
    font-size: 11px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 700;
  }
  .disc {
    font-size: 13px;
    color: var(--accent);
    font-weight: 700;
  }
  .title {
    font-family: var(--font-display);
    font-size: 19px;
    line-height: 1.2;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .prices {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: auto;
  }
  .now {
    font-family: var(--font-display);
    font-size: 24px;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .was {
    font-size: 12px;
    color: var(--muted);
    text-decoration: line-through;
  }
  .ends {
    font-size: 11px;
    color: var(--muted);
  }
</style>
