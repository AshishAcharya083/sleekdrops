---
import { ASSESSMENT_SUMMARY, INDEPENDENCE_MECHANISM, methodologyHref } from '@lib/methodology';

/**
 * AffiliateDisclosure — the disclosure every page with affiliate links carries.
 *
 * Two placements, because the regulators and Amazon want different things from
 * it. The FTC's Endorsement Guides say a reader must be able to see the
 * disclosure and the link "at the same time", and the ACCC's 2023 sweep named a
 * disclosure "at the very end" in "small or hard to read font" as the failing
 * pattern - so an article opens with the `inline` line under its byline, before
 * the first /go/ link. Amazon's Operating Agreement (§5) requires the sentence
 * "As an Amazon Associate I earn from qualifying purchases" clearly and
 * prominently; both placements carry it.
 *
 * It says what is true, in the methodology page's own words rather than a
 * paraphrase of them: we earn a commission, reviews are researched rather than
 * hands-on, and independence is a mechanism. The sentences come from
 * @lib/methodology so this block cannot drift from /how-we-rate. Tone (per the
 * design system) is calm and informational, not shouty.
 */
export interface Props {
  /** `inline` is the one-line note under a byline; `note` the fuller block at the end. */
  variant?: 'note' | 'inline';
}
const { variant = 'note' } = Astro.props;
// One string, because Astro drops the bare space between two expressions.
const howWeWork = [ASSESSMENT_SUMMARY, ...INDEPENDENCE_MECHANISM].join(' ');
---
{variant === 'inline' ? (
  <p class="disclosure disclosure--inline" role="note" aria-label="Affiliate disclosure">
    This page has affiliate links: when you buy through them, SleekDrops earns a commission at no extra cost to you. As an Amazon Associate we earn from qualifying purchases. A commission never affects a score or a recommendation.
    <a href={methodologyHref()}>How we rate</a> and <a href="/disclaimer">how we work</a>.
  </p>
) : (
  <aside class="disclosure" role="note" aria-label="Affiliate disclosure">
    <strong>Disclosure.</strong> SleekDrops earns a commission when you buy through links on this page, at no extra cost to you. As an Amazon Associate we earn from qualifying purchases. {howWeWork}{' '}<a href={methodologyHref()}>How we rate products</a>, <a href="/disclaimer">how we work</a>, and <a href="/how-we-research">how we research</a>.
  </aside>
)}

<style>
  .disclosure {
    border-top: 1px solid var(--hairline);
    padding: 14px 0 0;
    margin: 40px 0 0;
    font-size: 12px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 64ch;
  }
  .disclosure strong { color: var(--ink-2); font-weight: 600; }
  .disclosure a { color: inherit; text-underline-offset: 2px; }

  .disclosure--inline {
    border-top: 0;
    border-left: 2px solid var(--hairline-strong);
    padding: 2px 0 2px 12px;
    margin: 12px 0 0;
    font-size: 13px;
    /* The same absolute measure the trust blocks above it use. A ch-based one
       resolves to a different pixel width at each block's font size, which is
       what left their right edges staggered. */
    max-width: 640px;
  }
</style>
