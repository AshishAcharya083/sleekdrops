---
/**
 * ComparisonTable — side-by-side score table for roundups and reviews.
 * Pass `headers` and `rows` (each row is `{ cells, winner? }`). Winner
 * row gets a soft accent gradient and a leading star.
 */
export interface Row {
  cells: string[];
  winner?: boolean;
}
export interface Props {
  headers: string[];
  rows: Row[];
  /** Optional caption above the table. */
  caption?: string;
}
const { headers, rows, caption } = Astro.props;
---
<figure class="compare-wrap">
  {caption && <figcaption>{caption}</figcaption>}
  <table class="compare">
    <thead>
      <tr>{headers.map((h) => <th>{h}</th>)}</tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr class:list={[{ winner: row.winner }]}>
          {row.cells.map((cell, i) => (
            <td class:list={[{ price: i > 0 && /^\$/.test(cell) }]}>{cell}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</figure>

<style>
  .compare-wrap { margin: 24px 0; }
  figcaption {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--muted);
    margin-bottom: 12px;
  }
  .compare {
    width: 100%;
    border-collapse: collapse;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 14px;
    overflow: hidden;
    font-size: 14px;
  }
  .compare thead { background: var(--surface-2); }
  .compare th {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    text-align: left;
    padding: 12px 16px;
  }
  .compare td {
    padding: 14px 16px;
    border-top: 1px solid var(--hairline);
    color: var(--ink-2);
  }
  .compare td:first-child {
    font-family: var(--font-display);
    font-size: 17px;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .compare .winner {
    background: linear-gradient(to right, var(--accent-soft) 0%, transparent 50%);
  }
  .compare .winner td:first-child::before {
    content: "★ ";
    color: var(--accent);
    font-size: 13px;
    vertical-align: 2px;
  }
  .compare .price { font-family: var(--font-mono); }
</style>
