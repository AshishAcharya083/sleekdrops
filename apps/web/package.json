{
  "name": "@sleekdrops/web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "SleekDrops.com — Exclusive deals dropping daily. Editorial affiliate blog built with Astro.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "fetch-content": "node scripts/fetch-content.mjs",
    "dev": "node scripts/fetch-content.mjs && astro dev",
    "start": "node scripts/fetch-content.mjs && astro dev",
    "prebuild": "node scripts/fetch-content.mjs && node scripts/generate-redirects.mjs",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "generate:redirects": "node scripts/generate-redirects.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "3.2.1",
    "@getdevteam/analytics-web": "^0.2.0",
    "astro": "^4.16.19",
    "remark-gfm": "^4.0.1",
    "schema-dts": "^2.0.0",
    "sharp": "^0.34.5",
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "wrangler": "4.93.1"
  }
}
