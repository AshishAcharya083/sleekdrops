# Google Analytics 4 - measurement id of the property THIS environment reports
# into, from GA4 Admin -> Data streams -> Web. PUBLIC_ exposes it to the Astro
# build; it ships in the JS bundle every visitor downloads and is not a secret.
#
# One property per environment, so a preview deploy and a developer's laptop
# cannot land traffic in the reports the site is actually judged on. The deploy
# workflows read the value from the matching GitHub Environment
# (GA4_MEASUREMENT_ID under `develop` / `production`); this entry is only for
# running the site locally, and the right value for it is usually **empty**.
#
# Empty - and so is anything that is not a `G-` measurement id, which is refused
# rather than tagged with - disables GA4 silently after one [analytics] warning:
# gtag.js is never requested and no `_ga` cookie is written. Nothing else about
# the site changes, and the DevTeam sink is unaffected.
#
# GA4 only ever loads for a visitor who accepted analytics. A decline, an
# unanswered banner and a Global Privacy Control / Do-Not-Track signal all load
# nothing at all; a withdrawal sets the tag's own opt-out flag and deletes its
# `_ga` cookies in the same page load. See src/lib/ga.ts.
PUBLIC_GA4_ID=

# DevTeam Analytics - public ingest key (dtp_...) for this project. DevTeam mints
# it and publishes it to the repo's Actions settings itself; this entry is only for
# running the site locally. PUBLIC_ exposes it to the Astro build. A configured
# non-production build starts anonymous analytics silently; production ignores the
# key in code as well as leaving it empty in its deploy workflow. Leave empty to
# disable the DevTeam sink.
PUBLIC_DEVTEAM_ANALYTICS_INGEST_KEY=

# DevTeam Analytics ingest host. Local testing: http://localhost:6080.
# Hosted develop: the environment's DEVTEAM_ANALYTICS_HOST variable.
PUBLIC_DEVTEAM_ANALYTICS_HOST=http://localhost:6080

# Reserved for local testing of the redirect handler's telemetry seam. Deployed
# /go routes deliberately pass no processor credentials until public privacy,
# jurisdiction and retention terms are available.
DEVTEAM_ANALYTICS_INGEST_KEY=
DEVTEAM_ANALYTICS_HOST=

# DevTeam Analytics in-app feedback. `true` renders a floating Feedback button
# once the visitor has accepted analytics: it screenshots the page, lets them
# circle what is wrong and leaves a comment, and the report lands in the DevTeam
# project's User feedback tab. Anything other than `true` (including unset) hides
# it entirely - the widget code is never even downloaded.
#
# Unlike the two settings above, this is a visible control on the page rather
# than a silent sink, so it is enabled per environment. The develop deploy sets
# it; production does not.
PUBLIC_DEVTEAM_ANALYTICS_FEEDBACK=

# DevTeam A/B Testing - flag-delivery host + per-environment client key. DevTeam
# mints these and publishes them to the repo's Actions settings itself; these
# entries are only for running the site locally. The SDK reads the GrowthBook
# payload from <host>/api/features/<key>. Leave the key empty to disable
# experiments silently: every feature then falls back to its code-side default.
#
# The host MUST be https:// for any deployed (https) site: the payload decides
# what the page renders, and it is neither signed nor encrypted. On a https page
# a http:// host is refused with one warning - the browser would block it as
# mixed content anyway. Plain http is accepted only when the page itself is http
# (local dev, e.g. http://localhost:6080 against a mock).
#
# The client key is read-only and ships in the JS bundle every visitor
# downloads - never put a privileged platform API key here.
PUBLIC_DEVTEAM_FLAGS_HOST=https://app.internal.getdevteam.ai
PUBLIC_DEVTEAM_FLAGS_CLIENT_KEY=

# Google AdSense - publisher id (ca-pub-...) plus one slot id per placement.
# All of them are public: they ship in the JS bundle and in the ad markup every
# visitor downloads, which is why they use the PUBLIC_ prefix and live in repo
# settings rather than in secrets. Minted in the AdSense console per environment,
# so develop and production carry different values.
#
# Leave the publisher id empty to disable ads silently after one [ads] warning -
# no partner script is ever requested and no ads.txt is generated. Leave a single
# slot id empty to disable that one placement and leave the rest running.
#
# The publisher id must read ca-pub-<digits>; anything else fails the build
# rather than publishing an ads.txt that authorises the wrong seller.
#
# In production the publisher tag also loads Google's certified CMP. Publish an
# EEA/UK/Swiss message in AdSense Privacy & messaging before requesting review.
# The privacy-policy route deliberately omits the tag, as Google requires.
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT_ARTICLE_MID=
PUBLIC_ADSENSE_SLOT_ARTICLE_END=
PUBLIC_ADSENSE_SLOT_SIDEBAR=
PUBLIC_ADSENSE_SLOT_FEED=

# Public site URL — used by sitemap, RSS, canonical tags, JSON-LD.
# Override per-environment: production = https://sleekdrops.com,
# preview/develop = https://develop.sleekdrops.com.
SITE_URL=https://sleekdrops.com

# Which deployment this build is - the one thing that decides whether search
# engines may index it. Only the exact string `production` is indexable; unset
# (the right value for local work), empty, misspelled or `Production` all read as
# a preview and get `noindex, nofollow` on every page plus a robots.txt with no
# sitemap.
#
# Fail-safe in that direction on purpose: develop is held at the same code level
# as main and renders the same pages from the same live content, so an indexable
# preview is a second copy of the site competing with the real one - and, to an
# AdSense reviewer, duplicated content on a domain the account does not own. The
# opposite failure (production de-listing itself) is caught by a test over both
# deploy workflows rather than left to chance. See src/lib/site-env.ts.
PUBLIC_SITE_ENV=

# Cloudflare Pages — used by the GitHub Actions deploy workflow.
# Create a Cloudflare API token with "Pages: Edit" permission.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PROJECT_NAME=sleekdrops

# Cloudflare D1 — editorial content database (sleekdrops-content). Used by
# scripts/fetch-content.mjs at build time. The database id is not a secret;
# the token needs "Account → D1 → Read" (falls back to CLOUDFLARE_API_TOKEN).
D1_DATABASE_ID=b98d83ac-a2a5-42cb-a367-0cb71b902670
CLOUDFLARE_D1_TOKEN=

# Cloudflare R2 — image storage (v2). Used by the publishing pipeline,
# NOT by the Astro build itself. Safe to leave empty in v1.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sleekdrops-images
R2_PUBLIC_URL=https://images.sleekdrops.com

# Publishing-pipeline backend — POSTs to this when ready. Optional.
PUBLISH_API_URL=
PUBLISH_API_TOKEN=
