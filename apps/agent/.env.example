# ── Database ────────────────────────────────────────────────────────────────
# Postgres holds pipeline state (topics, articles, agent sessions, usage).
# `pnpm db:up` at the repo root starts the dockerized instance this points to.
DATABASE_URL=postgres://sleekdrops:sleekdrops@localhost:5544/sleekdrops_agent

# ── LLM engines ─────────────────────────────────────────────────────────────
# Two engines, routed by model id (claude-* → Claude, everything else → Gemini).
# Values pasted in admin Settings take precedence over this file.
#
# Gemini (the image agent, which needs this engine's vision and image
# generation — plus every other stage when the admin engine toggle is flipped
# to Gemini). Local dev: AI Studio key from
# aistudio.google.com — billing goes to the key's GCP project, so Google Cloud
# credits apply. On Cloud Run the three GOOGLE_* vars replace the key entirely
# (Vertex AI with the service account's ADC).
GEMINI_API_KEY=
MODEL_DEFAULT=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Claude subscription — the default engine for every stage that runs a prompt:
# topic scout, researcher, keyword strategist, outliner, writer, SEO reviewer
# and editor. Mint a one-year token with `claude setup-token` (needs a
# Pro/Max/Team/Enterprise plan) — it only works through the Claude Agent SDK,
# never as a raw API key. ANTHROPIC_API_KEY is the pay-per-token fallback when
# no token is set.
#
# With neither set, those stages FAIL with that message. They no longer fall
# back to Gemini on their own: the fallback was silent, so the panel said Opus 5
# while every article came out of gemini-2.5-flash. Flip the engine toggle in
# admin Settings if Gemini is what you want.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# ── Research (Tavily) ───────────────────────────────────────────────────────
# Two jobs. It gathers the evidence sweep for the topic scout, the researcher
# and the keyword strategist's SERP reads — and it backs the `web_search` tool
# the verifying stages call to check a price or a spec against a primary
# source. Same index either way, so a fact checked at review time comes from
# the same place the dossier did. Without it those tools fail closed: the model
# is told the lookup failed and leaves the claim unverified.
TAVILY_API_KEY=

# ── Hero images (GCS) ───────────────────────────────────────────────────────
# The image stage uploads found/generated hero images here and stores the
# public URL in the post frontmatter. The admin panel's own hero-image drop
# (manual topic drawer + article panel) uses the same bucket, and refuses the
# upload with a pointer to this variable when it is empty. Create the bucket
# once, then make it publicly readable:
#   gcloud storage buckets create gs://sleekdrops-images --location=us-central1 --uniform-bucket-level-access
#   gcloud storage buckets add-iam-policy-binding gs://sleekdrops-images --member=allUsers --role=roles/storage.objectViewer
# Auth is ADC (Cloud Run service account / `gcloud auth application-default login`).
# Leave empty to skip the stage — articles fall back to the cover-fill art.
GCS_IMAGES_BUCKET=
GCS_PUBLIC_BASE=https://storage.googleapis.com

# ── Cloudflare D1 (publish target) ──────────────────────────────────────────
# The publisher agent writes finished posts + affiliate links into the same
# D1 database the website builds from. Token needs "Account → D1 → Edit".
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=b98d83ac-a2a5-42cb-a367-0cb71b902670
CLOUDFLARE_D1_TOKEN=

# ── GitHub (rebuild dispatch) ───────────────────────────────────────────────
# After publishing to D1 the publisher fires a `content-updated` repository
# dispatch so Cloudflare Pages rebuilds the site (~90s to live).
GITHUB_TOKEN=
GITHUB_REPO=AshishAcharya083/sleekdrops

# ── Admin API ───────────────────────────────────────────────────────────────
# Optional bearer token protecting /api/*. Leave empty to disable auth locally.
ADMIN_TOKEN=
PORT=8787

# ── Worker ──────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=2
POLL_MS=5000
