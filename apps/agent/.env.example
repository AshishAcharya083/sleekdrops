# ── Database ────────────────────────────────────────────────────────────────
# Postgres holds pipeline state (topics, articles, agent sessions, usage).
# `pnpm db:up` at the repo root starts the dockerized instance this points to.
DATABASE_URL=postgres://sleekdrops:sleekdrops@localhost:5544/sleekdrops_agent

# ── LLM engines ─────────────────────────────────────────────────────────────
# Two engines, routed by model id (claude-* → Claude, everything else → Gemini).
# Values pasted in admin Settings take precedence over this file.
#
# Gemini (topic scout, researcher, outliner, SEO reviewer — and writer/editor
# when the admin toggle says so). Local dev: AI Studio key from
# aistudio.google.com — billing goes to the key's GCP project, so Google Cloud
# credits apply. On Cloud Run the three GOOGLE_* vars replace the key entirely
# (Vertex AI with the service account's ADC).
GEMINI_API_KEY=
MODEL_DEFAULT=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Claude subscription (writer + editor by default). Mint a one-year token with
# `claude setup-token` (needs a Pro/Max/Team/Enterprise plan) — it only works
# through the Claude Agent SDK, never as a raw API key. ANTHROPIC_API_KEY is
# the pay-per-token fallback when no token is set.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# ── Research (Tavily) ───────────────────────────────────────────────────────
# Used by the topic scout + researcher agents for live web evidence.
TAVILY_API_KEY=

# ── Cloudflare D1 (publish target) ──────────────────────────────────────────
# The publisher agent writes finished posts + affiliate links into the same
# D1 database the website builds from. Token needs "Account → D1 → Edit".
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=b98d83ac-a2a5-42cb-a367-0cb71b902670
CLOUDFLARE_D1_TOKEN=

# ── GitHub (rebuild dispatch) ───────────────────────────────────────────────
# After publishing to D1 the publisher fires a `content-updated` repository
# dispatch so Cloudflare Pages rebuilds the site (~90s to live).
GITHUB_TOKEN=
GITHUB_REPO=AshishAcharya083/sleekdrops

# ── Admin API ───────────────────────────────────────────────────────────────
# Optional bearer token protecting /api/*. Leave empty to disable auth locally.
ADMIN_TOKEN=
PORT=8787

# ── Worker ──────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=2
POLL_MS=5000
