{
  "name": "@sleekdrops/agent",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "SleekDrops agent platform — multi-agent SEO content pipeline (Gemini ADK + Claude subscription) with Postgres state and an admin API.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.207",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@google/adk": "^1.3.0",
    "@google/genai": "^1.52.0",
    "@hono/node-server": "^1.19.0",
    "dotenv": "^16.4.5",
    "hono": "^4.9.0",
    "pg": "^8.16.0",
    "sharp": "^0.34.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0"
  }
}
