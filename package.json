{
  "name": "sleekdrops-monorepo",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "SleekDrops — Astro affiliate blog (apps/web) + autonomous AI publishing platform (apps/agent, apps/admin).",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "dev:web": "pnpm --filter @sleekdrops/web dev",
    "dev:agent": "pnpm --filter @sleekdrops/agent dev",
    "dev:admin": "pnpm --filter @sleekdrops/admin dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @sleekdrops/web build",
    "build:agent": "pnpm --filter @sleekdrops/agent build",
    "build:admin": "pnpm --filter @sleekdrops/admin build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @sleekdrops/agent migrate",
    "agent": "pnpm --filter @sleekdrops/agent start"
  }
}
