+{"version":3,"sources":["../src/feedback/capture.ts","../src/feedback/exportImage.ts","../src/feedback/strokes.ts","../src/feedback/index.ts","../src/index.ts","../src/context.ts","../src/pageviews.ts","../src/storage.ts"],"sourcesContent":["import { toCanvas } from \"html-to-image\";\n\nconst TRANSPARENT_PIXEL_DATA_URL =\n  \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNgYAAAAAMAASsJTYQAAAAASUVORK5CYII=\";\n\n// html-to-image has no clip option, so the visible viewport is captured by\n// sizing the render to the window and translating the cloned document up and\n// left by the current scroll offset.\nexport async function captureViewport(exclude: Node, pixelRatio: number): Promise<HTMLCanvasElement> {\n  return toCanvas(document.documentElement, {\n    filter: (node) => node !== exclude,\n    imagePlaceholder: TRANSPARENT_PIXEL_DATA_URL,\n    pixelRatio,\n    width: window.innerWidth,\n    height: window.innerHeight,\n    style: {\n      transform: `translate(${-window.scrollX}px, ${-window.scrollY}px)`,\n    },\n  });\n}\n","import type { Stroke } from \"./strokes\";\n\nexport interface ExportedImage {\n  base64: string;\n  contentType: \"image/png\" | \"image/jpeg\";\n}\n\nexport interface ExportImageOptions {\n  maxBytes: number;\n}\n\nconst JPEG_QUALITY = 0.85;\nconst DOWNSCALE_FACTOR = 0.7;\nconst MIN_EXPORT_DIMENSION = 200;\n\nexport function drawStrokes(ctx: CanvasRenderingContext2D, strokes: readonly Stroke[]): void {\n  for (const stroke of strokes) {\n    const [first, ...rest] = stroke.points;\n    if (!first) continue;\n    ctx.strokeStyle = stroke.color;\n    ctx.lineWidth = stroke.width;\n    ctx.lineCap = \"round\";\n    ctx.lineJoin = \"round\";\n    ctx.beginPath();\n    ctx.moveTo(first.x, first.y);\n    if (rest.length === 0) ctx.lineTo(first.x, first.y);\n    for (const point of rest) ctx.lineTo(point.x, point.y);\n    ctx.stroke();\n  }\n}\n\n// Composites the full-resolution screenshot with the strokes, then encodes to\n// PNG; when the PNG is over the byte budget it falls back to JPEG and, if\n// still too large, downscales in 0.7 steps until it fits. Returns null when no\n// encoding fits or the environment has no working 2d canvas.\nexport async function exportAnnotatedImage(\n  source: HTMLCanvasElement,\n  strokes: readonly Stroke[],\n  options: ExportImageOptions,\n): Promise<ExportedImage | null> {\n  try {\n    const composed = compose(source, strokes);\n    if (!composed) return null;\n\n    const png = await encode(composed, \"image/png\");\n    if (png && png.size <= options.maxBytes) {\n      return { base64: await blobToBase64(png), contentType: \"image/png\" };\n    }\n\n    let canvas = composed;\n    let jpeg = await encode(canvas, \"image/jpeg\", JPEG_QUALITY);\n    while (\n      jpeg &&\n      jpeg.size > options.maxBytes &&\n      Math.min(canvas.width, canvas.height) * DOWNSCALE_FACTOR >= MIN_EXPORT_DIMENSION\n    ) {\n      const smaller = downscale(canvas, DOWNSCALE_FACTOR);\n      if (!smaller) break;\n      canvas = smaller;\n      jpeg = await encode(canvas, \"image/jpeg\", JPEG_QUALITY);\n    }\n    if (jpeg && jpeg.size <= options.maxBytes) {\n      return { base64: await blobToBase64(jpeg), contentType: \"image/jpeg\" };\n    }\n    return null;\n  } catch {\n    return null;\n  }\n}\n\nfunction compose(source: HTMLCanvasElement, strokes: readonly Stroke[]): HTMLCanvasElement | null {\n  const canvas = document.createElement(\"canvas\");\n  canvas.width = source.width;\n  canvas.height = source.height;\n  const ctx = get2dContext(canvas);\n  if (!ctx || canvas.width === 0 || canvas.height === 0) return null;\n  // JPEG has no alpha channel and would composite transparency onto black.\n  ctx.fillStyle = \"#ffffff\";\n  ctx.fillRect(0, 0, canvas.width, canvas.height);\n  ctx.drawImage(source, 0, 0);\n  drawStrokes(ctx, strokes);\n  return canvas;\n}\n\nfunction downscale(source: HTMLCanvasElement, factor: number): HTMLCanvasElement | null {\n  const canvas = document.createElement(\"canvas\");\n  canvas.width = Math.max(1, Math.round(source.width * factor));\n  canvas.height = Math.max(1, Math.round(source.height * factor));\n  const ctx = get2dContext(canvas);\n  if (!ctx) return null;\n  ctx.drawImage(source, 0, 0, canvas.width, canvas.height);\n  return canvas;\n}\n\nfunction get2dContext(canvas: HTMLCanvasElement): CanvasRenderingContext2D | null {\n  try {\n    return canvas.getContext(\"2d\");\n  } catch {\n    return null;\n  }\n}\n\nfunction encode(canvas: HTMLCanvasElement, type: string, quality?: number): Promise<Blob | null> {\n  return new Promise((resolve) => {\n    try {\n      canvas.toBlob((blob) => resolve(blob), type, quality);\n    } catch {\n      resolve(null);\n    }\n  });\n}\n\nexport async function blobToBase64(blob: Blob): Promise<string> {\n  const bytes = new Uint8Array(await blob.arrayBuffer());\n  let binary = \"\";\n  const chunkSize = 0x8000;\n  for (let i = 0; i < bytes.length; i += chunkSize) {\n    binary += String.fromCharCode(...bytes.subarray(i, i + chunkSize));\n  }\n  return btoa(binary);\n}\n","export interface StrokePoint {\n  x: number;\n  y: number;\n}\n\nexport interface Stroke {\n  points: StrokePoint[];\n  color: string;\n  width: number;\n}\n\nexport interface StrokeStore {\n  begin(color: string, width: number, point: StrokePoint): void;\n  extend(point: StrokePoint): void;\n  end(): void;\n  undo(): void;\n  clear(): void;\n  list(): readonly Stroke[];\n  isDrawing(): boolean;\n}\n\n// Each stroke snapshots its color and width when it starts, so a later color\n// change never restyles strokes already on the canvas. Undo and clear are\n// no-ops mid-drag to keep the active stroke consistent.\nexport function createStrokeStore(): StrokeStore {\n  const strokes: Stroke[] = [];\n  let active: Stroke | undefined;\n  return {\n    begin(color, width, point) {\n      if (active) return;\n      active = { points: [point], color, width };\n      strokes.push(act