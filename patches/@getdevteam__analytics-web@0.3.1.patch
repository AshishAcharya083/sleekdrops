\n  undoButton.addEventListener(\"click\", () =>\n    safely(() => {\n      strokes.undo();\n      repaint();\n    }),\n  );\n  clearButton.addEventListener(\"click\", () =>\n    safely(() => {\n      strokes.clear();\n      repaint();\n    }),\n  );\n\n  const onKeyDown = (event: Event): void => {\n    if ((event as { key?: unknown }).key === \"Escape\") safely(close);\n  };\n\n  function lockScroll(): void {\n    if (previousBodyOverflow !== undefined) return;\n    previousBodyOverflow = document.body.style.overflow;\n    document.body.style.overflow = \"hidden\";\n  }\n\n  function unlockScroll(): void {\n    if (previousBodyOverflow === undefined) return;\n    document.body.style.overflow = previousBodyOverflow;\n    previousBodyOverflow = undefined;\n  }\n\n  function setError(message: string | undefined): void {\n    error.hidden = message === undefined;\n    error.textContent = message ?? \"\";\n  }\n\n  function setFormVisible(visible: boolean): void {\n    const hasPreview = sourceCanvas !== undefined;\n    panel.classList.toggle(\"compact\", !visible || !hasPreview);\n    preview.hidden = !visible || !hasPreview;\n    tools.hidden = !visible || !hasPreview;\n    comment.hidden = !visible;\n    actions.hidden = !visible;\n  }\n\n  function showOverlay(canvas: HTMLCanvasElement | undefined): void {\n    overlaySession += 1;\n    draftFeedbackId = uuidV7();\n    sourceCanvas = canvas;\n    strokes.end();\n    strokes.clear();\n    comment.value = \"\";\n    setError(undefined);\n    success.hidden = true;\n    submitButton.disabled = false;\n    if (canvas) {\n      canvas.classList.add(\"shot\");\n      preview.insertBefore(canvas, drawCanvas);\n      drawCanvas.width = canvas.width;\n      drawCanvas.height = canvas.height;\n      penWidth = PEN_WIDTH * (pixelRatio > 0 ? pixelRatio : 1);\n      repaint();\n    }\n    selectColor(colors[0] ?? DEFAULT_COLORS[0]!);\n    setFormVisible(true);\n    overlay.hidden = false;\n    overlayOpen = true;\n    lockScroll