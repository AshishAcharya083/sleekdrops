-{"version":3,"sources":["../src/feedback/capture.ts","../src/feedback/exportImage.ts","../src/feedback/strokes.ts","../src/feedback/index.ts","../src/index.ts","../src/context.ts","../src/pageviews.ts","../src/storage.ts"],"sourcesContent":["import { toCanvas } from \"html-to-image\";\n\nconst TRANSPARENT_PIXEL_DATA_URL =\n  \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNgYAAAAAMAASsJTYQAAAAASUVORK5CYII=\";\n\n// html-to-image has no clip option, so the visible viewport is captured by\n// sizing the render to the window and translating the cloned document up and\n// left by the current scroll offset.\nexport async function captureViewport(exclude: Node, pixelRatio: number): Promise<HTMLCanvasElement> {\n  return toCanvas(document.documentElement, {\n    filter: (node) => node !== exclude,\n    imagePlaceholder: TRANSPARENT_PIXEL_DATA_URL,\n    pixelRatio,\n    width: window.innerWidth,\n    height: window.innerHeight,\n    style: {\n      transform: `translate(${-window.scrollX}px, ${-window.scrollY}px)`,\n    },\n  });\n}\n","import type { Stroke } from \"./strokes\";\n\nexport interface ExportedImage {\n  base64: string;\n  contentType: \"image/png\" | \"image/jpeg\";\n}\n\nexport interface ExportImageOptions {\n  maxBytes: number;\n}\n\nconst JPEG_QUALITY = 0.85;\nconst DOWNSCALE_FACTOR = 0.7;\nconst MIN_EXPORT_DIMENSION = 200;\n\nexport function drawStrokes(ctx: CanvasRenderingContext2D, strokes: readonly Stroke[]): void {\n  for (const stroke of strokes) {\n    const [first, ...rest] = stroke.points;\n    if (!first) continue;\n    ctx.strokeStyle = stroke.color;\n    ctx.lineWidth = stroke.width;\n    ctx.lineCap = \"round\";\n    ctx.lineJoin = \"round\";\n    ctx.beginPath();\n    ctx.moveTo(first.x, first.y);\n    if (rest.length === 0) ctx.lineTo(first.x, first.y);\n    for (const point of rest) ctx.lineTo(point.x, point.y);\n    ctx.stroke();\n  }\n}\n\n// Composites the full-resolution screenshot with the strokes, then encodes to\n// PNG; when the PNG is over the byte budget it falls back to JPEG and, if\n// still too large, downscales in 0.7 steps until it fits. Returns null when no\n// encoding fits or the environment has no working 2d canvas.\nexport async function exportAnnotatedImage(\n  source: HTMLCanvasElement,\n  strokes: readonly Stroke[],\n  options: ExportImageOptions,\n): Promise<ExportedImage | null> {\n  try {\n    const composed = compose(source, strokes);\n    if (!composed) return null;\n\n    const png = await encode(composed, \"image/png\");\n    if (png && png.size <= options.maxBytes) {\n      return { base64: await blobToBase64(png), contentType: \"image/png\" };\n    }\n\n    let canvas = composed;\n    let jpeg = await encode(canvas, \"image/jpeg\", JPEG_QUALITY);\n    while (\n      jpeg &&\n      jpeg.size > options.maxBytes &&\n      Math.min(canvas.width, canvas.height) * DOWNSCALE_FACTOR >= MIN_EXPORT_DIMENSION\n    ) {\n      const smaller = downscale(canvas, DOWNSCALE_FACTOR);\n      if (!smaller) break;\n      canvas = smaller;\n      jpeg = await encode(canvas, \"image/jpeg\", JPEG_QUALITY);\n    }\n    if (jpeg && jpeg.size <= options.maxBytes) {\n      return { base64: await blobToBase64(jpeg), contentType: \"image/jpeg\" };\n    }\n    return null;\n  } catch {\n    return null;\n  }\n}\n\nfunction compose(source: HTMLCanvasElement, strokes: readonly Stroke[]): HTMLCanvasElement | null {\n  const canvas = document.createElement(\"canvas\");\n  canvas.width = source.width;\n  canvas.height = source.height;\n  const ctx = get2dContext(canvas);\n  if (!ctx || canvas.width === 0 || canvas.height === 0) return null;\n  // JPEG has no alpha channel and would composite transparency onto black.\n  ctx.fillStyle = \"#ffffff\";\n  ctx.fillRect(0, 0, canvas.width, canvas.height);\n  ctx.drawImage(source, 0, 0);\n  drawStrokes(ctx, strokes);\n  return canvas;\n}\n\nfunction downscale(source: HTMLCanvasElement, factor: number): HTMLCanvasElement | null {\n  const canvas = document.createElement(\"canvas\");\n  canvas.width = Math.max(1, Math.round(source.width * factor));\n  canvas.height = Math.max(1, Math.round(source.height * factor));\n  const ctx = get2dContext(canvas);\n  if (!ctx) return null;\n  ctx.drawImage(source, 0, 0, canvas.width, canvas.height);\n  return canvas;\n}\n\nfunction get2dContext(canvas: HTMLCanvasElement): CanvasRenderingContext2D | null {\n  try {\n    return canvas.getContext(\"2d\");\n  } catch {\n    return null;\n  }\n}\n\nfunction encode(canvas: HTMLCanvasElement, type: string, quality?: number): Promise<Blob | null> {\n  return new Promise((resolve) => {\n    try {\n      canvas.toBlob((blob) => resolve(blob), type, quality);\n    } catch {\n      resolve(null);\n    }\n  });\n}\n\nexport async function blobToBase64(blob: Blob): Promise<string> {\n  const bytes = new Uint8Array(await blob.arrayBuffer());\n  let binary = \"\";\n  const chunkSize = 0x8000;\n  for (let i = 0; i < bytes.length; i += chunkSize) {\n    binary += String.fromCharCode(...bytes.subarray(i, i + chunkSize));\n  }\n  return btoa(binary);\n}\n","export interface StrokePoint {\n  x: number;\n  y: number;\n}\n\nexport interface Stroke {\n  points: StrokePoint[];\n  color: string;\n  width: number;\n}\n\nexport interface StrokeStore {\n  begin(color: string, width: number, point: StrokePoint): void;\n  extend(point: StrokePoint): void;\n  end(): void;\n  undo(): void;\n  clear(): void;\n  list(): readonly Stroke[];\n  isDrawing(): boolean;\n}\n\n// Each stroke snapshots its color and width when it starts, so a later color\n// change never restyles strokes already on the canvas. Undo and clear are\n// no-ops mid-drag to keep the active stroke consistent.\nexport function createStrokeStore(): StrokeStore {\n  const strokes: Stroke[] = [];\n  let active: Stroke | undefined;\n  return {\n    begin(color, width, point) {\n      if (active) return;\n      active = { points: [point], color, width };\n      strokes.push(active);\n    },\n    extend(point) {\n      active?.points.push(point);\n    },\n    end() {\n      active = undefined;\n    },\n    undo() {\n      if (active) return;\n      strokes.pop();\n    },\n    clear() {\n      if (active) return;\n      strokes.length = 0;\n    },\n    list: () => strokes,\n    isDrawing: () => active !== undefined,\n  };\n}\n\nexport interface DisplayRect {\n  left: number;\n  top: number;\n  width: number;\n  height: number;\n}\n\n// Strokes live in the screenshot's own pixel space so they land at the same\n// spot in the full-resolution export as they did on the scaled-down preview.\n// A degenerate rect (jsdom reports zero sizes) maps 1:1 instead of dividing by zero.\nexport function mapToImagePoint(\n  clientX: number,\n  clientY: number,\n  rect: DisplayRect,\n  imageWidth: number,\n  imageHeight: number,\n): StrokePoint {\n  const scaleX = rect.width > 0 && imageWidth > 0 ? imageWidth / rect.width : 1;\n  const scaleY = rect.height > 0 && imageHeight > 0 ? imageHeight / rect.height : 1;\n  return { x: (clientX - rect.left) * scaleX, y: (clientY - rect.top) * scaleY };\n}\n","import { uuidV7, type EventContext, type FetchLike } from \"@getdevteam/analytics-core\";\nimport { captureViewport } from \"./capture\";\nimport { drawStrokes, exportAnnotatedImage, type ExportedImage } from \"./exportImage\";\nimport { createStrokeStore, mapToImagePoint, type StrokePoint } from \"./strokes\";\nimport type { FeedbackHandle, WebFeedbackOptions } from \"./types\";\nimport type { Stroke } from \"./strokes\";\n\nexport type { FeedbackHandle, WebFeedbackOptions } from \"./types\";\nexport { createStrokeStore, mapToImagePoint } from \"./strokes\";\nexport type { Stroke, StrokePoint, StrokeStore } from \"./strokes\";\nexport { exportAnnotatedImage } from \"./exportImage\";\nexport type { ExportedImage } from \"./exportImage\";\n\nexport interface FeedbackConfig {\n  url: string;\n  key: string;\n  fetch: FetchLike | undefined;\n  getDistinctId(): string;\n  getSessionId(): string;\n  getContext(): EventContext;\n  options: WebFeedbackOptions;\n  onError(error: unknown): void;\n}\n\nexport interface FeedbackDeps {\n  capture(exclude: HTMLElement, pixelRatio: number): Promise<HTMLCanvasElement>;\n  exportAnnotated(\n    source: HTMLCanvasElement,\n    strokes: readonly Stroke[],\n    options: { maxBytes: number },\n  ): Promise<ExportedImage | null>;\n}\n\nconst DEFAULT_COLORS = [\"#f44336\", \"#4caf50\", \"#2196f3\", \"#ffeb3b\"];\nconst DEFAULT_ACCENT = \"#5b9cf5\";\nconst DEFAULT_Z_INDEX = 2147483000;\nconst PEN_WIDTH = 5;\nconst MAX_SCREENSHOT_BYTES = 5 * 1024 * 1024;\nconst MAX_TEXT_LENGTH = 10000;\nconst MAX_PAGE_URL_LENGTH = 2048;\nconst SUCCESS_CLOSE_DELAY_MS = 1600;\n\nconst defaultDeps: FeedbackDeps = {\n  capture: captureViewport,\n  exportAnnotated: exportAnnotatedImage,\n};\n\nexport function mountFeedback(config: FeedbackConfig, deps: FeedbackDeps = defaultDeps): FeedbackHandle {\n  const options = config.options;\n  const colors = options.colors && options.colors.length > 0 ? options.colors : DEFAULT_COLORS;\n  const accent = options.accentColor ?? DEFAULT_ACCENT;\n  const pixelRatio =\n    options.pixelRatio ??\n    Math.min(typeof devicePixelRatio === \"number\" && devicePixelRatio > 0 ? devicePixelRatio : 1, 2);\n\n  let destroyed = false;\n  let overlayOpen = false;\n  // Bumped on every open and close: a submit resolving for an earlier overlay\n  // session (sent, then closed and reopened mid-flight) must not paint its\n  // outcome into, or auto-close, the new draft.\n  let overlaySession = 0;\n  let capturing = false;\n  let sending = false;\n  // One idempotency key per draft (the contract dedupes on it), so retrying a\n  // failed send cannot store the same feedback twice; re-minted on each open.\n  let draftFeedbackId = uuidV7();\n  let sourceCanvas: HTMLCanvasElement | undefined;\n  let activeColor = colors[0] ?? DEFAULT_COLORS[0]!;\n  let penWidth = PEN_WIDTH;\n  let previousBodyOverflow: string | undefined;\n  let closeTimer: ReturnType<typeof setTimeout> | undefined;\n  let drawContext: CanvasRenderingContext2D | null | undefined;\n  const strokes = createStrokeStore();\n\n  const report = (error: unknown): void => {\n    try {\n      config.onError(error);\n    } catch {\n      // a throwing observer must never break the host app\n    }\n  };\n  const safely = (fn: () => void): void => {\n    try {\n      fn();\n    } catch (error) {\n      report(error);\n    }\n  };\n\n  const host = document.createElement(\"div\");\n  host.setAttribute(\"data-devteam-feedback\", \"\");\n  const shadow = host.attachShadow({ mode: \"open\" });\n\n  const style = document.createElement(\"style\");\n  style.textContent = buildStyles(options, accent);\n\n  const container = element(\"div\", \"container\");\n  const fab = element(\"button\", \"fab\");\n  fab.type = \"button\";\n  fab.textContent = options.buttonLabel ?? \"Feedback\";\n\n  const overlay = element(\"div\", \"overlay\");\n  overlay.hidden = true;\n  const backdrop = element(\"div\", \"backdrop\");\n  const panel = element(\"div\", \"panel\");\n  panel.setAttribute(\"role\", \"dialog\");\n  panel.setAttribute(\"aria-modal\", \"true\");\n\n  const header = element(\"div\", \"header\");\n  const title = element(\"div\", \"title\");\n  title.textContent = options.title ?? \"Send feedback\";\n  const closeButton = element(\"button\", \"close\");\n  closeButton.type = \"button\";\n  closeButton.setAttribute(\"aria-label\", \"Close\");\n  closeButton.textContent = \"×\";\n  header.append(title, closeButton);\n\n  const preview = element(\"div\", \"preview\");\n  const drawCanvas = document.createElement(\"canvas\");\n  drawCanvas.className = \"draw\";\n  preview.appendChild(drawCanvas);\n\n  const tools = element(\"div\", \"tools\");\n  const swatches = colors.map((color) => {\n    const swatch = element(\"button\", \"swatch\");\n    swatch.type = \"button\";\n    swatch.style.background = color;\n    swatch.setAttribute(\"aria-label\", `Pen color ${color}`);\n    swatch.addEventListener(\"click\", () => safely(() => selectColor(color)));\n    tools.appendChild(swatch);\n    return { color, swatch };\n  });\n  const undoButton = element(\"button\", \"tool undo\");\n  undoButton.type = \"button\";\n  undoButton.textContent = \"Undo\";\n  const clearButton = element(\"button\", \"tool clear\");\n  clearButton.type = \"button\";\n  clearButton.textContent = \"Clear\";\n  tools.append(undoButton, clearButton);\n\n  const comment = document.createElement(\"textarea\");\n  comment.className = \"comment\";\n  comment.placeholder = options.commentPlaceholder ?? \"What went wrong, or what could be better?\";\n  comment.maxLength = MAX_TEXT_LENGTH;\n\n  const error = element(\"div\", \"error\");\n  error.hidden = true;\n  const success = element(\"div\", \"success\");\n  success.hidden = true;\n  success.textContent = options.successMessage ?? \"Thanks for the feedback!\";\n\n  const actions = element(\"div\", \"actions\");\n  const cancelButton = element(\"button\", \"cancel\");\n  cancelButton.type = \"button\";\n  cancelButton.textContent = \"Cancel\";\n  const submitButton = element(\"button\", \"submit\");\n  submitButton.type = \"button\";\n  submitButton.textContent = options.submitLabel ?? \"Send\";\n  actions.append(cancelButton, submitButton);\n\n  panel.append(header, preview, tools, comment, error, success, actions);\n  overlay.append(backdrop, panel);\n  container.append(fab, overlay);\n  shadow.append(style, container);\n\n  if (document.body) {\n    document.body.appendChild(host);\n  } else {\n    document.addEventListener(\n      \"DOMContentLoaded\",\n      () => {\n        if (!destroyed) document.body?.appendChild(host);\n      },\n      { once: true },\n    );\n  }\n\n  function selectColor(color: string): void {\n    activeColor = color;\n    for (const entry of swatches) {\n      entry.swatch.classList.toggle(\"active\", entry.color === color);\n    }\n  }\n  selectColor(activeColor);\n\n  function context2d(): CanvasRenderingContext2D | null {\n    if (drawContext === undefined) {\n      try {\n        drawContext = drawCanvas.getContext(\"2d\");\n      } catch {\n        drawContext = null;\n      }\n    }\n    return drawContext;\n  }\n\n  function repaint(): void {\n    const ctx = context2d();\n    if (!ctx) return;\n    ctx.clearRect(0, 0, drawCanvas.width, drawCanvas.height);\n    drawStrokes(ctx, strokes.list());\n  }\n\n  function pointFromEvent(event: Event): StrokePoint | undefined {\n    const { clientX, clientY } = event as { clientX?: unknown; clientY?: unknown };\n    if (typeof clientX !== \"number\" || typeof clientY !== \"number\") return undefined;\n    const rect = drawCanvas.getBoundingClientRect();\n    return mapToImagePoint(clientX, clientY, rect, drawCanvas.width, drawCanvas.height);\n  }\n\n  function withPointerCapture(event: Event, action: \"set\" | \"release\"): void {\n    const pointerId = (event as { pointerId?: unknown }).pointerId;\n    if (typeof pointerId !== \"number\") return;\n    const method = action === \"set\" ? drawCanvas.setPointerCapture : drawCanvas.releasePointerCapture;\n    if (typeof method !== \"function\") return;\n    try {\n      method.call(drawCanvas, pointerId);\n    } catch {\n      // pointer capture is a nicety; drawing works without it\n    }\n  }\n\n  const onPointerDown = (event: Event): void =>\n    safely(() => {\n      if (!sourceCanvas || sending) return;\n      const point = pointFromEvent(event);\n      if (!point) return;\n      if (typeof event.preventDefault === \"function\") event.preventDefault();\n      withPointerCapture(event, \"set\");\n      strokes.begin(activeColor, penWidth, point);\n      repaint();\n    });\n  const onPointerMove = (event: Event): void =>\n    safely(() => {\n      if (!strokes.isDrawing()) return;\n      const point = pointFromEvent(event);\n      if (!point) return;\n      strokes.extend(point);\n      repaint();\n 